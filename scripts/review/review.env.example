# Settings of the review environments. Copy to /etc/clubnetz-review/review.env on the server,
# fill in the values and make it readable by root only (chmod 600). Never commit the filled-in file.

# Every pull request gets https://pr-<number>.<REVIEW_DOMAIN>, the caught emails are at https://mail.<REVIEW_DOMAIN>.
# Needs a DNS record *.<REVIEW_DOMAIN> pointing at the server.
REVIEW_DOMAIN=review.clubnetz.app

# The image the GitHub workflow builds, a package of its own (not the production image). The server must be able
# to pull it: docker login ghcr.io as root, with a token that can read packages.
REVIEW_IMAGE=ghcr.io/sleepwalkerffs/clubnetz-review

# How many pull requests may have a review environment at the same time (each needs about 300-500 MB of memory)
REVIEW_MAX_ENVIRONMENTS=3
REVIEW_MEMORY_LIMIT=768m

# The username and password prompt in front of every review environment and the mail catcher, in htpasswd format (bcrypt):
#   docker run --rm httpd:2.4-alpine htpasswd -nbB <user> '<password>'
# Put the output in single quotes, it contains $ signs.
REVIEW_BASIC_AUTH='user:$2y$05$replace-me'

# The password of every account in the review environments, including yours (you log in with your own email).
# Use one you use nowhere else: the review environments run code that is not merged yet.
REVIEW_LOGIN_PASSWORD=replace-me

# Password of the review database server (only reachable inside the review network). Generate one: openssl rand -hex 24
REVIEW_POSTGRES_PASSWORD=replace-me

# The production database the template is copied from (refresh-template.sh). Find the container with: docker ps | grep postgres
PRODUCTION_DB_CONTAINER=replace-me
PRODUCTION_DB_NAME=postgres
PRODUCTION_DB_USER=postgres

# Coolify's proxy. Check the names with: docker inspect coolify-proxy | grep -E 'entrypoints|certresolver'
TRAEFIK_CONTAINER=coolify-proxy
TRAEFIK_ENTRYPOINT_HTTP=http
TRAEFIK_ENTRYPOINT_HTTPS=https
TRAEFIK_CERT_RESOLVER=letsencrypt
