      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>View.Emails.EmailChanged.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Localization\View.Emails.ForgotPassword.de.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Localization\View.Emails.ForgotPassword.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>View.Emails.ForgotPassword.Designer.cs</LastGenOutput>
