    <Compile Update="Resources\Localization\View.Emails.VerifyUser.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>View.Emails.VerifyUser.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\assets\emails\email.css">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\EmailTemplates\*.md" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\Localization\View.Emails.BookingDeleted.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>View.Emails.BookingDeleted.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Localization\View.Emails.ConfirmEmailChange.de.resx">
