      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>View.Emails.ConfirmEmailChange.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Localization\View.Emails.EmailChanged.de.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
