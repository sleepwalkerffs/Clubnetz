<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1873</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pin transitive deps to patched versions (NU1902/NU1903 vulnerability advisories) -->
