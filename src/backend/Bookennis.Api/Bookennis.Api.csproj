    <EmbeddedResource Update="Resources\Localization\View.Emails.VerifyUser.de.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Localization\View.Emails.VerifyUser.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>View.Emails.VerifyUser.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
