  <ItemGroup>
    <ProjectReference Include="..\Bookennis.Domain\Bookennis.Domain.csproj" />
    <ProjectReference Include="..\..\shared\Bookennis.Shared.csproj" />
    <ProjectReference Include="..\..\frontend\Bookennis.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Resources\Localization\View.Emails.BookingDeleted.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>View.Emails.BookingDeleted.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\Localization\View.Emails.ConfirmEmailChange.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>View.Emails.ConfirmEmailChange.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\Localization\View.Emails.EmailChanged.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>View.Emails.EmailChanged.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\Localization\View.Emails.ForgotPassword.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>View.Emails.ForgotPassword.resx</DependentUpon>
