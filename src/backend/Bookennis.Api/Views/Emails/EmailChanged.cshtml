@using Texts = Bookennis.Api.Resources.Localization.View_Emails_EmailChanged;
@using Bookennis.Api.Business.Admin;
@model EmailChangedViewModel
@{
    Layout = "~/Views/Emails/_EmailLayout.cshtml";
    ViewData["Title"] = Texts.Title;
    ViewData["Emoji"] = "🔒";
}
<p>@string.Format(Texts.Greeting, Model.FirstName, Model.LastName)</p>
<p>@string.Format(Texts.Description, Model.NewEmail)</p>
<p>@Texts.NotYou</p>
<p><a class="btn" href="@Model.ForgotPasswordUrl">@Texts.Link</a></p>
