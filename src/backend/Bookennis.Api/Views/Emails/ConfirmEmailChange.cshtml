@using Texts = Bookennis.Api.Resources.Localization.View_Emails_ConfirmEmailChange;
@using Bookennis.Api.Business.Admin;
@model ConfirmEmailChangeViewModel
@{
    Layout = "~/Views/Emails/_EmailLayout.cshtml";
    ViewData["Title"] = Texts.Title;
    ViewData["Emoji"] = "📬";
}
<p>@string.Format(Texts.Greeting, Model.FirstName, Model.LastName)</p>
<p>@(Model.RequestedByAdmin ? Texts.Description : string.Format(Texts.DescriptionSelf, Model.NewEmail))</p>
<p><a class="btn" href="@Model.Url">@Texts.Link</a></p>
<p class="text-secondary">@Texts.Validity</p>
<p class="text-secondary">@Texts.Ignore</p>
