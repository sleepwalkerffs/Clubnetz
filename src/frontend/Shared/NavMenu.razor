@using Bookennis.Client.Localization
@using Bookennis.Client.Localization.Navigation
@using Bookennis.Client.Services
@using Bookennis.Client.Services.HttpClients.Account
@using Bookennis.Client.Services.Store.Badges
@using Bookennis.Client.Services.Store.ClubProfile
@using Bookennis.Client.Services.Store.Profile
@using Bookennis.Client.Services.Store.Push
@using Bookennis.Client.Services.UserAccessor
@using Bookennis.Client.Components.Shared
@using Bookennis.Shared.Controller.Shared
@using System.Globalization

@implements IDisposable

<div class="bookennis-nav">
    <AuthorizeView>
        <Authorized>
            <div class="bookennis-nav-profile">
                <button type="button" class="bookennis-nav-profile__user" @onclick="NavigateToProfile" title="@Locale["MyProfile"]">
                    <UserAvatar FirstName="@(UserDataAccessor.FirstName ?? "")" LastName="@(UserDataAccessor.LastName ?? "")" ProfilePictureUrl="@ProfileStore.ProfilePictureUrl" BadgeImageUrl="@BadgesStore.MyDisplayBadgeImageUrl" BadgeLevel="@BadgesStore.MyDisplayBadgeLevel" Size="Size.Large" AvatarClass="bookennis-nav-avatar" />
                    <span class="bookennis-nav-profile__text">
                        <span class="bookennis-nav-profile__name">@context.User.Identity?.Name</span>
                        <span class="bookennis-nav-profile__link">@Locale["MyProfile"]</span>
                    </span>
                </button>
                <ClubSwitcher />
            </div>
        </Authorized>
    </AuthorizeView>

    <div class="pa-2">
        <MudNavMenu Rounded="true" Color="Color.Primary">
            @if (ClubProfileStore.SelectedClub is null)
            {
                <MudNavLink Match="NavLinkMatch.All" Href="/" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
            }
            else
            {
                @foreach (var section in Sections.Where(s => s.Items.Count > 0))
                {
                    @if (section.Title is not null)
                    {
                        <div class="bookennis-nav-section">@section.Title</div>
                    }
                    @foreach (var item in section.Items)
                    {
                        <MudNavLink Href="@item.Href" Icon="@item.Icon">@item.Title</MudNavLink>
                    }
                }
            }
            <AuthorizeView>
                <Authorized>
                    <div class="bookennis-nav-section">@Locale["Section_Account"]</div>
                    <AuthorizeView Roles="Administrator">
                        <Authorized Context="adminContext">
                            <MudNavLink Href="/admin" Icon="@Icons.Material.Filled.AdminPanelSettings">@Locale["AdminPanel"]</MudNavLink>
                        </Authorized>
                    </AuthorizeView>
                    <MudNavLink OnClick="@LogoutUser" Icon="@Icons.Material.Filled.Logout">@Locale["Logout"]</MudNavLink>
                </Authorized>
                <NotAuthorized>
                    <MudNavLink Href="/account/login" Icon="@Icons.Material.Filled.Login">
                        @Locale["Login"]
                    </MudNavLink>
                </NotAuthorized>
            </AuthorizeView>
        </MudNavMenu>
        <LegalLinks OnDarkBackground="true" Class="mt-4 mb-2" />
    </div>
</div>

@code {

    [Inject]
    private IAccountHttpClient AccountHttpClient { get; set; } = null!;
    [Inject]
    private IAuthStateChanged AuthState { get; set; } = null!;
    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;
    [Inject]
    private IClaimsUserDataAccessor UserDataAccessor { get; set; } = null!;
    [Inject]
    private IProfileStore ProfileStore { get; set; } = null!;
    [Inject]
    private IClubProfileStore ClubProfileStore { get; set; } = null!;
    [Inject]
    private IBadgesStore BadgesStore { get; set; } = null!;
    [Inject]
    private IPushStore PushStore { get; set; } = null!;
    [Inject]
    private IStringLocalizer<NavigationLocale> Locale { get; set; } = null!;
    [Inject]
    private IStringLocalizer<SharedLocale> SharedLocale { get; set; } = null!;

    private sealed record NavItem(string Href, string Icon, string Title);

    private sealed record NavSection(string? Title, List<NavItem> Items);

    private bool Has(MemberRole role) => ClubProfileStore.Roles.Contains(role);

    /// <summary>
    /// What a member uses first, then what they manage, grouped by topic, so every role finds its pages in the same place.
    /// In support mode there is no member, so only the management pages are shown, as for a club admin.
    /// </summary>
    private IEnumerable<NavSection> Sections
    {
        get
        {
            var club = $"/clubs/{ClubProfileStore.SelectedClubId}";
            var bookingPlan = $"{club}/booking?Start={DateOnly.FromDateTime(DateTime.Today).ToString(CultureInfo.InvariantCulture)}&End={DateOnly.FromDateTime(DateTime.Today.AddDays(6)).ToString(CultureInfo.InvariantCulture)}";
            var isSupport = ClubProfileStore.IsSupportMode;
            // Members who are not active (not enrolled, no staff role) don't see the other members: no leaderboard, statistics, Wrapped, planner
            var isActive = isSupport || ClubProfileStore.IsActiveMember;
            var isAdmin = isSupport || Has(MemberRole.Admin);
            var isMaintainer = Has(MemberRole.Maintainer);
            var isSportsDirector = Has(MemberRole.SportsDirector);
            var isTreasurer = isAdmin || Has(MemberRole.Treasurer);

            // My Club is the start page of a club, it is also served under /clubs/{id}
            var clubItems = isSupport
                ? new List<NavItem> { new(bookingPlan, Icons.Material.Filled.SportsTennis, Locale["BookingPlan"]) }
                : [new($"{club}/my-club", Icons.Material.Filled.Home, Locale["MyClub"]), new(bookingPlan, Icons.Material.Filled.SportsTennis, Locale["Book"])];
            clubItems.Add(new($"{club}/news", Icons.Material.Filled.Campaign, Locale["News"]));
            clubItems.Add(new($"{club}/calendar", Icons.Material.Filled.CalendarMonth, Locale["Calendar"]));
            if (isActive && !isSupport)
                clubItems.Add(new($"{club}/leaderboard", Icons.Material.Filled.EmojiEvents, Locale["Leaderboard"]));
            yield return new(null, clubItems);

            if (!isSupport)
            {
                var personal = new List<NavItem> { new($"{club}/membership", Icons.Material.Filled.CardMembership, Locale["Membership"]) };
                if (isActive)
                {
                    personal.Add(new($"{club}/statistics", Icons.Material.Filled.BarChart, Locale["MyStatistics"]));
                    personal.Add(new($"{club}/wrapped", Icons.Material.Filled.AutoAwesome, Locale["Wrapped"]));
                    personal.Add(new($"{club}/subscription-planner", Icons.Material.Filled.EventRepeat, Locale["SubscriptionPlanner"]));
                }
                yield return new(Locale["Section_Personal"], personal);
            }

            var membersAndFees = new List<NavItem>();
            if (isAdmin || isMaintainer)
                membersAndFees.Add(new($"{club}/members", Icons.Material.Filled.Groups2, Locale["Members"]));
            if (isTreasurer)
            {
                membersAndFees.Add(new($"{club}/court-sales", Icons.Material.Filled.PointOfSale, Locale["CourtSales"]));
                membersAndFees.Add(new($"{club}/membership-plans", Icons.Material.Filled.ReceiptLong, Locale["MembershipPlans"]));
                membersAndFees.Add(new($"{club}/membership-payments", Icons.Material.Filled.Payments, Locale["MembershipPayments"]));
            }
            yield return new(Locale["Section_MembersAndFees"], membersAndFees);

            var courtsAndPlay = new List<NavItem>();
            // The roles that may move any booking (see BookingDetail); the page itself needs a large screen
            if (isAdmin || isSportsDirector || Has(MemberRole.YouthSportsDirector) || isMaintainer || Has(MemberRole.Trainer))
                courtsAndPlay.Add(new($"{club}/planner", Icons.Material.Filled.ViewTimeline, Locale["Planner"]));
            if (isAdmin || isMaintainer || isSportsDirector)
                courtsAndPlay.Add(new($"{club}/court-blockings", Icons.Material.Filled.Lock, Locale["CourtBlockings"]));
            if (isAdmin || isSportsDirector || Has(MemberRole.YouthSportsDirector))
                courtsAndPlay.Add(new($"{club}/badge-settings", Icons.Material.Filled.MilitaryTech, Locale["Badges"]));
            if (isAdmin || isMaintainer)
                courtsAndPlay.Add(new($"{club}/club-statistics", Icons.Material.Filled.Analytics, Locale["ClubStatistics"]));
            yield return new(Locale["Section_CourtsAndPlay"], courtsAndPlay);

            if (isAdmin)
            {
                yield return new(Locale["Section_ClubSetup"],
                [
                    new($"{club}/profile", Icons.Material.Filled.Tune, Locale["ClubSettings"]),
                    new($"{club}/email-templates", Icons.Material.Filled.MarkEmailRead, Locale["EmailTemplates"]),
                    new($"{club}/api-keys", Icons.Material.Filled.Key, Locale["ApiKeys"])
                ]);
            }
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ClubProfileStore.OnClubProfileChanged += OnClubProfileChanged;
        BadgesStore.OnMyDisplayBadgeChanged += StateHasChanged;
    }

    private async void OnClubProfileChanged()
    {
        StateHasChanged();
        if (ClubProfileStore.MemberId > 0)
        {
            try
            {
                await BadgesStore.LoadMyDisplayBadge(ClubProfileStore.MemberId);
            }
            catch (OperationCanceledException)
            {
                // Expected: a newer load superseded this one
            }
        }
    }

    private void NavigateToProfile() => NavigationManager.NavigateToProfile();

    private async Task LogoutUser()
    {
        // While still signed in: this device must not get the notifications of the user who leaves
        await PushStore.DetachDevice();

        var result = await AccountHttpClient.LogoutUser();
        if (result.Success)
        {
            AuthState.AuthStateChanged();
            NavigationManager.NavigateToLogin();
        }
    }

    public void Dispose()
    {
        ClubProfileStore.OnClubProfileChanged -= OnClubProfileChanged;
        BadgesStore.OnMyDisplayBadgeChanged -= StateHasChanged;
    }
}