@using Bookennis.Client.Components.Shared
@using Bookennis.Client.Components.Shared.Dialogs
@using Bookennis.Client.Localization
@using Bookennis.Client.Localization.Pages.ClubShell
@using Bookennis.Client.Localization.Pages.Trophies
@using Bookennis.Client.Pages.ClubShell.Members.Components
@using Bookennis.Client.Services.Store.Badges
@using Bookennis.Client.Services.Store.Profile
@using Bookennis.Client.Services.UserAccessor
@using Bookennis.Client.Utils
@using Bookennis.Shared.Controller.MemberBadges
@using Bookennis.Shared.Controller.OneTimeBadges
@using Microsoft.Extensions.Localization

<BaseDialog Title="@SharedLocale["BadgeSettings"]"
            Loading="@BadgesStore.IsSaving"
            SubmitFunc="Submit"
            SubmitCaption="@SharedLocale["Save"]"
            CancelFunc="Cancel"
            CancelCaption="@SharedLocale["Cancel"]">
    <div class="badge-settings">
        @* What the choice looks like: the badge sits on the profile picture *@
        <div class="badge-settings__preview" style="--badge-color: @(selectedOption is null ? "var(--mud-palette-lines-inputs)" : BadgeColors.ForLevel(SelectedLevel))">
            <div class="badge-settings__avatar">
                <UserAvatar FirstName="@(UserDataAccessor.FirstName ?? "")" LastName="@(UserDataAccessor.LastName ?? "")" ProfilePictureUrl="@ProfileStore.ProfilePictureUrl" Size="Size.Large" />
                @if (selectedOption is not null)
                {
                    <div class="badge-settings__avatar-badge">
                        <BadgeIcon ImageUrl="@SelectedImageUrl" Level="@SelectedLevel" Size="Size.Small" />
                    </div>
                }
            </div>
            <div class="badge-settings__preview-text">
                <div class="badge-settings__caption">@SharedLocale["BadgePreviewTitle"]</div>
                <div class="badge-settings__preview-name">@(SelectedName ?? SharedLocale["NoBadge"])</div>
                <div class="badge-settings__hint">@SharedLocale["BadgePreviewHint"]</div>
            </div>
        </div>

        @if (Seasons.Count == 0)
        {
            <div class="badge-settings__empty">
                <div class="badge-settings__empty-emoji" aria-hidden="true">🏅</div>
                <div>@SharedLocale["NoBadges"]</div>
            </div>
        }
        else
        {
            @if (Seasons.Count > 1)
            {
                <ChoiceChips TItem="SeasonOption" Items="@Seasons" Label="@ClubLocale["Season"]" TextFunc="@(season => season.SeasonFrom.Year.ToString())"
                             Value="@Seasons.FirstOrDefault(s => s.SeasonId == selectedSeasonId)" ValueChanged="@(season => selectedSeasonId = season.SeasonId)" />
            }

            <div>
                <div class="badge-settings__caption badge-settings__caption--section">@SharedLocale["DisplayBadge"]</div>
                <div class="badge-grid" role="radiogroup" aria-label="@SharedLocale["DisplayBadge"]">
                    <button type="button" class="badge-option badge-option--none @(selectedOption is null ? "badge-option--selected" : null)"
                            role="radio" aria-checked="@(selectedOption is null ? "true" : "false")" @onclick="@(() => selectedOption = null)">
                        <span class="badge-option__none" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Block" /></span>
                        <span class="badge-option__name">@SharedLocale["NoBadge"]</span>
                    </button>
                    @foreach (var badge in TierBadgesForSelectedSeason.OrderByDescending(b => b.Level))
                    {
                        @BadgeTile(new BadgeOption(badge.MemberBadgeId, false), badge.Name, badge.ImageUrl, badge.Level)
                    }
                    @foreach (var badge in OneTimeBadgesForSelectedSeason)
                    {
                        @BadgeTile(new BadgeOption(badge.MemberOneTimeBadgeId, true), badge.Name, badge.ImageUrl, null)
                    }
                </div>
            </div>
        }

        <div class="badge-settings__visibility">
            <div class="badge-settings__visibility-text">
                <div class="badge-settings__visibility-title">@SharedLocale["TrophyCaseVisibility"]</div>
                <div class="badge-settings__hint">@SharedLocale["TrophyCasePublicLabel"]</div>
            </div>
            <MudSwitch T="bool" @bind-Value="trophyCasePublic" Color="Color.Primary" aria-label="@SharedLocale["TrophyCasePublicLabel"]" />
        </div>
    </div>
</BaseDialog>

@code {
    private record struct BadgeOption(int Id, bool IsOneTime);

    [Parameter]
    public int MemberId { get; set; }

    [Parameter]
    public List<EarnedBadgeDto> EarnedBadges { get; set; } = [];

    [Parameter]
    public List<OneTimeBadgeAwardDto> OneTimeBadges { get; set; } = [];

    [Parameter]
    public int? CurrentDisplayBadgeId { get; set; }

    [Parameter]
    public int? CurrentDisplayOneTimeBadgeId { get; set; }

    [Parameter]
    public bool TrophyCasePublic { get; set; }

    [CascadingParameter]
    public IMudDialogInstance MudDialog { get; set; } = null!;

    [Inject]
    private IBadgesStore BadgesStore { get; set; } = null!;

    [Inject]
    private IStringLocalizer<SharedLocale> SharedLocale { get; set; } = null!;

    [Inject]
    private IStringLocalizer<ClubShellLocale> ClubLocale { get; set; } = null!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = null!;

    [Inject]
    private IStringLocalizer<BackendErrorCodeLocale> BackendLocale { get; set; } = null!;

    [Inject]
    private IProfileStore ProfileStore { get; set; } = null!;

    [Inject]
    private IClaimsUserDataAccessor UserDataAccessor { get; set; } = null!;

    [Inject]
    private IStringLocalizer<TrophyLocale> TrophyLocale { get; set; } = null!;

    private BadgeOption? selectedOption;
    private bool trophyCasePublic;
    private int? selectedSeasonId;

    private record SeasonOption(int SeasonId, DateOnly SeasonFrom);

    private List<SeasonOption> Seasons => EarnedBadges
        .Select(b => new { b.SeasonId, b.SeasonFrom })
        .Concat(OneTimeBadges.Select(b => new { b.SeasonId, b.SeasonFrom }))
        .GroupBy(b => new { b.SeasonId, b.SeasonFrom })
        .Select(g => new SeasonOption(g.Key.SeasonId, g.Key.SeasonFrom))
        .OrderByDescending(s => s.SeasonFrom)
        .ToList();

    private List<EarnedBadgeDto> TierBadgesForSelectedSeason => selectedSeasonId.HasValue
        ? EarnedBadges.Where(b => b.SeasonId == selectedSeasonId.Value).ToList()
        : EarnedBadges;

    private List<OneTimeBadgeAwardDto> OneTimeBadgesForSelectedSeason => selectedSeasonId.HasValue
        ? OneTimeBadges.Where(b => b.SeasonId == selectedSeasonId.Value).ToList()
        : OneTimeBadges;

    protected override void OnInitialized()
    {
        trophyCasePublic = TrophyCasePublic;

        if (CurrentDisplayBadgeId.HasValue)
        {
            selectedOption = new BadgeOption(CurrentDisplayBadgeId.Value, false);
            var currentBadge = EarnedBadges.FirstOrDefault(b => b.MemberBadgeId == CurrentDisplayBadgeId);
            selectedSeasonId = currentBadge?.SeasonId ?? Seasons.FirstOrDefault()?.SeasonId;
        }
        else if (CurrentDisplayOneTimeBadgeId.HasValue)
        {
            selectedOption = new BadgeOption(CurrentDisplayOneTimeBadgeId.Value, true);
            var currentBadge = OneTimeBadges.FirstOrDefault(b => b.MemberOneTimeBadgeId == CurrentDisplayOneTimeBadgeId);
            selectedSeasonId = currentBadge?.SeasonId ?? Seasons.FirstOrDefault()?.SeasonId;
        }
        else
        {
            selectedSeasonId = Seasons.FirstOrDefault()?.SeasonId;
        }
    }

    // The selection is kept while looking through the seasons, the preview shows it
    private EarnedBadgeDto? SelectedTierBadge => selectedOption is { IsOneTime: false } option ? EarnedBadges.FirstOrDefault(b => b.MemberBadgeId == option.Id) : null;

    private OneTimeBadgeAwardDto? SelectedOneTimeBadge => selectedOption is { IsOneTime: true } option ? OneTimeBadges.FirstOrDefault(b => b.MemberOneTimeBadgeId == option.Id) : null;

    private string? SelectedName => SelectedTierBadge?.Name ?? SelectedOneTimeBadge?.Name;

    private string? SelectedImageUrl => SelectedTierBadge?.ImageUrl ?? SelectedOneTimeBadge?.ImageUrl;

    private int? SelectedLevel => SelectedTierBadge?.Level;

    private RenderFragment BadgeTile(BadgeOption option, string name, string? imageUrl, int? level) => __builder =>
    {
        var selected = selectedOption == option;

        <button type="button" class="badge-option @(selected ? "badge-option--selected" : null)" style="--badge-color: @BadgeColors.ForLevel(level)"
                role="radio" aria-checked="@(selected ? "true" : "false")" @onclick="@(() => selectedOption = option)">
            @if (selected)
            {
                <span class="badge-option__check" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" /></span>
            }
            <BadgeIcon ImageUrl="@imageUrl" Level="@level" Alt="@name" Size="Size.Large" Class="badge-option__icon" />
            <span class="badge-option__name">@name</span>
            <span class="badge-option__pill">@(level is { } l ? string.Format(TrophyLocale["LevelShort"], l) : TrophyLocale["SpecialAward"])</span>
        </button>
    };

    private async Task<DialogResult?> Submit()
    {
        var result = await BadgesStore.UpdateBadgeSettings(MemberId, new UpdateMemberBadgeSettingsModel
        {
            DisplayBadgeId = selectedOption is { IsOneTime: false } t ? t.Id : null,
            DisplayOneTimeBadgeId = selectedOption is { IsOneTime: true } o ? o.Id : null,
            TrophyCasePublic = trophyCasePublic
        });

        if (!result.Success)
        {
            Snackbar.ShowErrorDetails(result, BackendLocale);
            return null;
        }

        MudDialog.Close(DialogResult.Ok(true));
        return null;
    }

    private Task<DialogResult?> Cancel()
    {
        MudDialog.Cancel();
        return Task.FromResult<DialogResult?>(null);
    }
}
