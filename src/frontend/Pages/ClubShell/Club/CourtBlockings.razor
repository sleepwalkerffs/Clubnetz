@page "/clubs/{ClubId:int}/court-blockings"
@using Bookennis.Client.Components.Shared
@using Bookennis.Client.Localization
@using Bookennis.Client.Localization.Pages.CourtBlockings
@using Bookennis.Client.Pages.ClubShell.Club.Components
@using Bookennis.Client.Pages.ClubShell.Club.Dialogs
@using Bookennis.Client.Services.Store.Club
@using Bookennis.Client.Services.Store.ClubProfile
@using Bookennis.Client.Services.Store.CourtBlockings
@using Bookennis.Client.Utils
@using Bookennis.Shared.Controller.CourtBlockings
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@implements IDisposable

<PageTitle>@L["Title"]</PageTitle>

@if (!CanManage)
{
    <MudAlert Severity="Severity.Info">@L["NoAccess"]</MudAlert>
}
else if (Store.Blockings is not { } blockings)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}
else
{
    var now = DateTimeOffset.Now;
    var activeCount = blockings.Count(b => b.NextOccurrence <= now);
    var upcomingCount = blockings.Count(b => b.NextOccurrence > now);

    <div class="blockings-page">
        <AdminHero Emoji="🔒" Eyebrow="@ClubProfileStore.SelectedClub?.ClubName" Title="@L["Title"]" Subtitle="@L["Subtitle"]">
            <Chips>
                <span class="hero-chip">⛔ @string.Format(L["ActiveChip"], activeCount)</span>
                <span class="hero-chip">🗓️ @string.Format(L["UpcomingChip"], upcomingCount)</span>
            </Chips>
        </AdminHero>

        <SectionCard Emoji="🗓️" Title="@L["ListTitle"]" Subtitle="@L[showPast ? "ListSubtitleWithPast" : "ListSubtitle"]">
            <Actions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="() => OpenDialog(null)">@L["Add"]</MudButton>
            </Actions>
            <ChildContent>
                @if (blockings.Count == 0)
                {
                    <div class="blockings-empty">
                        <div class="blockings-empty__emoji" aria-hidden="true">🎾</div>
                        <div class="blockings-empty__title">@L["EmptyTitle"]</div>
                        <div class="blockings-empty__text">@L["EmptyText"]</div>
                    </div>
                }
                else
                {
                    <div class="blockings">
                        @foreach (var blocking in blockings)
                        {
                            var isOver = blocking.NextOccurrence is null;
                            var isActive = blocking.NextOccurrence <= now;
                            <div class="blocking @(isOver ? "blocking--over" : null) @(isActive ? "blocking--active" : null)">
                                <div class="blocking__main">
                                    <div class="blocking__head">
                                        <span class="blocking__title">@blocking.Title</span>
                                        <span class="blocking__status">@CourtBlockingHelpers.StatusText(L, blocking, now)</span>
                                    </div>
                                    <div class="blocking__fact">
                                        <MudIcon Icon="@(blocking.RecurrenceIntervalWeeks is null ? Icons.Material.Filled.Schedule : Icons.Material.Filled.Repeat)" Class="blocking__icon" />
                                        <span>
                                            @CourtBlockingHelpers.WhenText(L, blocking)
                                            @if (CourtBlockingHelpers.RecurrenceText(L, blocking) is { } recurrence)
                                            {
                                                <span class="blocking__muted"> · @recurrence</span>
                                            }
                                        </span>
                                    </div>
                                    <div class="blocking__fact">
                                        <MudIcon Icon="@Icons.Material.Filled.SportsTennis" Class="blocking__icon" />
                                        <span>@CourtBlockingHelpers.CourtsText(L, blocking.CourtIds, ClubStore.Courts)</span>
                                    </div>
                                </div>
                                <div class="blocking__actions">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@SharedLocale["Edit"]" title="@SharedLocale["Edit"]"
                                                   OnClick="() => OpenDialog(blocking)" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="@SharedLocale["Delete"]" title="@SharedLocale["Delete"]"
                                                   Disabled="@Store.IsSaving" OnClick="() => Delete(blocking)" />
                                </div>
                            </div>
                        }
                    </div>
                }

                <MudSwitch T="bool" Value="showPast" ValueChanged="OnShowPastChanged" Color="Color.Primary" Label="@L["ShowPast"]" Class="mt-3" />
            </ChildContent>
        </SectionCard>
    </div>
}

@code {
    [Parameter] public int ClubId { get; set; }

    [Inject] private ICourtBlockingsStore Store { get; set; } = null!;
    [Inject] private IClubStore ClubStore { get; set; } = null!;
    [Inject] private IClubProfileStore ClubProfileStore { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private IStringLocalizer<CourtBlockingsLocale> L { get; set; } = null!;
    [Inject] private IStringLocalizer<SharedLocale> SharedLocale { get; set; } = null!;
    [Inject] private IStringLocalizer<BackendErrorCodeLocale> BackendLocale { get; set; } = null!;

    private bool showPast;

    private bool CanManage => CourtBlockingHelpers.CanManage(ClubProfileStore.Roles);

    protected override async Task OnInitializedAsync()
    {
        Store.OnBlockingsChanged += OnChanged;
        ClubProfileStore.OnClubProfileChanged += OnChanged;

        if (CanManage)
            await Task.WhenAll(ClubStore.LoadCourts(), Store.LoadBlockings(showPast));
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task OnShowPastChanged(bool value)
    {
        showPast = value;
        await Store.LoadBlockings(showPast);
    }

    private async Task OpenDialog(CourtBlockingDto? blocking)
    {
        var parameters = new DialogParameters<EditCourtBlockingDialog> { { d => d.Blocking, blocking }, { d => d.Courts, ClubStore.Courts } };
        var dialog = await DialogService.ShowAsync<EditCourtBlockingDialog>(L[blocking is null ? "NewTitle" : "EditTitle"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });

        if (await dialog.Result is { Canceled: false })
            await Store.LoadBlockings(showPast);
    }

    private async Task Delete(CourtBlockingDto blocking)
    {
        var confirmed = await DialogService.ShowMessageBox(L["DeleteTitle"], string.Format(L["DeleteConfirm"], blocking.Title),
            yesText: SharedLocale["Delete"], cancelText: SharedLocale["Cancel"]);
        if (confirmed != true)
            return;

        var result = await Store.DeleteBlocking(blocking.Id);
        if (!result.Success)
        {
            Snackbar.ShowErrorDetails(result, BackendLocale);
            return;
        }

        Snackbar.Add(L["Deleted"], Severity.Success);
        await Store.LoadBlockings(showPast);
    }

    public void Dispose()
    {
        Store.OnBlockingsChanged -= OnChanged;
        ClubProfileStore.OnClubProfileChanged -= OnChanged;
    }
}
