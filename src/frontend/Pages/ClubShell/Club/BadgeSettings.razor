@page "/clubs/{ClubId:int}/badge-settings"
@using System.Globalization
@using Bookennis.Client.Components.Shared
@using Bookennis.Client.Localization
@using Bookennis.Client.Localization.Pages.BadgeSettings
@using Bookennis.Client.Pages.ClubShell.Club.Dialogs
@using Bookennis.Client.Pages.ClubShell.Members.Components
@using Bookennis.Client.Pages.ClubShell.Members.Dialogs
@using Bookennis.Client.Services.Store.Badges
@using Bookennis.Client.Services.Store.Club
@using Bookennis.Client.Services.Store.ClubProfile
@using Bookennis.Client.Utils
@using Bookennis.Shared.Controller.BadgeTiers
@using Bookennis.Shared.Controller.Club
@using Bookennis.Shared.Controller.OneTimeBadges
@using Bookennis.Shared.Controller.Shared
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@implements IDisposable

<PageTitle>@L["Title"]</PageTitle>

@{
    var tiers = BadgesStore.BadgeTiers?.Tiers.OrderBy(t => t.Level).ToList() ?? [];
    var oneTimeBadges = BadgesStore.OneTimeBadges?.Badges ?? [];
    var season = ClubStore.Seasons.FirstOrDefault(s => s.Id == selectedSeasonId);
}

<div class="badge-page">
    <AdminHero Emoji="🏅" Eyebrow="@ClubProfileStore.SelectedClub?.ClubName" Title="@L["Title"]" Subtitle="@L["Subtitle"]">
        <Chips>
            <span class="hero-chip">🪜 @string.Format(L["TiersChip"], tiers.Count)</span>
            <span class="hero-chip">✨ @string.Format(L["OneTimeChip"], oneTimeBadges.Count)</span>
            <span class="hero-chip">🎉 @string.Format(L["AwardsChip"], tiers.Sum(t => t.EarnedCount) + oneTimeBadges.Sum(b => b.Awardees.Count))</span>
        </Chips>
        <Aside>
            <div class="badge-aside__caption">@L["SeasonCaption"]</div>
            <div class="badge-aside__value">@(season is null ? "–" : string.Format(L["SeasonName"], MemberAdminHelpers.SeasonLabel(season)))</div>
            @if (tiers.LastOrDefault(t => t.EarnedCount > 0) is { } topEarned)
            {
                <div class="badge-aside__text">@string.Format(L["TopEarned"], topEarned.Name, topEarned.EarnedCount)</div>
            }
            else
            {
                <div class="badge-aside__text">@L["NothingEarnedYet"]</div>
            }
        </Aside>
    </AdminHero>

    @if (ClubStore.Seasons.Count > 0)
    {
        <ChoiceChips TItem="SeasonResult" Items="@SeasonsNewestFirst" Value="@season" ValueChanged="@(s => OnSeasonChanged(s.Id))"
                     TextFunc="@(s => string.Format(L["SeasonName"], MemberAdminHelpers.SeasonLabel(s)))" ColorFunc="@(s => s.IsActive ? "#059669" : null)" />
    }
    else
    {
        <MudAlert Severity="Severity.Info">@L["NoSeasons"]</MudAlert>
    }

    <SectionCard Emoji="🪜" Title="@L["TiersTitle"]" Subtitle="@L["TiersSubtitle"]">
        <Actions>
            @if (isAdmin && selectedSeasonId is not null)
            {
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" aria-label="@L["CopyTiers"]" title="@L["CopyTiers"]"
                               OnClick="OpenCopyTiersDialog" Disabled="@(tiers.Count > 0)" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="() => OpenTierDialog(null)">@L["Add"]</MudButton>
            }
        </Actions>
        <ChildContent>
            @if (tiers.Count == 0)
            {
                <div class="badge-empty">
                    <div class="badge-empty__emoji" aria-hidden="true">🪜</div>
                    <div class="badge-empty__title">@L["NoTiers"]</div>
                    <div class="badge-empty__text">@L["NoTiersText"]</div>
                    @if (isAdmin && selectedSeasonId is not null)
                    {
                        <div class="badge-empty__actions">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => OpenTierDialog(null)">@L["AddTier"]</MudButton>
                            @if (ClubStore.Seasons.Count > 1)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="OpenCopyTiersDialog">@L["CopyTiers"]</MudButton>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                var maxEarned = Math.Max(1, tiers.Max(t => t.EarnedCount));
                <div class="ladder">
                    @for (var i = 0; i < tiers.Count; i++)
                    {
                        var tier = tiers[i];
                        @if (i > 0)
                        {
                            <div class="ladder__step" aria-hidden="true">
                                <span class="ladder__step-line"></span>
                                <span class="ladder__step-text">+@(tier.MatchesRequired - tiers[i - 1].MatchesRequired)</span>
                            </div>
                        }
                        <div class="ladder__item">
                            <TrophyTile Name="@tier.Name" ImageUrl="@tier.ImageUrl" Level="@tier.Level" OnClick="() => OpenTierDetail(tier)">
                                <span>🎾 @string.Format(L["MatchesRule"], tier.MatchesRequired)</span>
                                <span class="earned-bar" title="@string.Format(L["EarnedBy"], tier.EarnedCount)">
                                    <span style="width: @((tier.EarnedCount * 100.0 / maxEarned).ToString("0.#", CultureInfo.InvariantCulture))%"></span>
                                </span>
                                <span><strong>@tier.EarnedCount</strong> @L["Earned"]</span>
                            </TrophyTile>
                            @if (isAdmin)
                            {
                                @RenderActions($"tier-{tier.Id}", () => OpenTierDialog(tier), e => OnTierImageSelected(e, tier.Id), () => DeleteTier(tier))
                            }
                        </div>
                    }
                </div>
            }
        </ChildContent>
    </SectionCard>

    <SectionCard Emoji="✨" Title="@L["OneTimeTitle"]" Subtitle="@L["OneTimeSubtitle"]">
        <Actions>
            @if (canManageOneTimeBadges && selectedSeasonId is not null)
            {
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" aria-label="@L["CopyOneTime"]" title="@L["CopyOneTime"]"
                               OnClick="OpenCopyOneTimeBadgesDialog" Disabled="@(oneTimeBadges.Count > 0)" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="() => OpenOneTimeDialog(null)">@L["Add"]</MudButton>
            }
        </Actions>
        <ChildContent>
            @if (oneTimeBadges.Count == 0)
            {
                <div class="badge-empty">
                    <div class="badge-empty__emoji" aria-hidden="true">✨</div>
                    <div class="badge-empty__title">@L["NoOneTime"]</div>
                    <div class="badge-empty__text">@L["NoOneTimeText"]</div>
                    @if (canManageOneTimeBadges && selectedSeasonId is not null)
                    {
                        <div class="badge-empty__actions">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => OpenOneTimeDialog(null)">@L["AddOneTimeBadge"]</MudButton>
                            @if (ClubStore.Seasons.Count > 1)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="OpenCopyOneTimeBadgesDialog">@L["CopyOneTime"]</MudButton>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="specials">
                    @foreach (var badge in oneTimeBadges.OrderBy(b => b.Name))
                    {
                        <div class="specials__item">
                            <TrophyTile Name="@badge.Name" ImageUrl="@badge.ImageUrl" OnClick="() => OpenOneTimeDetail(badge)">
                                @if (badge.Awardees.Count == 0)
                                {
                                    <span class="awardees__none">@L["NotAwardedYet"]</span>
                                }
                                else
                                {
                                    <span class="awardees">
                                        @foreach (var awardee in badge.Awardees.Take(4))
                                        {
                                            <UserAvatar FirstName="@awardee.FirstName" LastName="@awardee.LastName" Size="Size.Small" Color="Color.Secondary" AvatarClass="awardees__avatar" />
                                        }
                                        @if (badge.Awardees.Count > 4)
                                        {
                                            <span class="awardees__more">+@(badge.Awardees.Count - 4)</span>
                                        }
                                    </span>
                                    <span>@string.Format(L["AwardedTo"], badge.Awardees.Count)</span>
                                }
                            </TrophyTile>
                            @if (canManageOneTimeBadges)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.EmojiEvents"
                                           OnClick="() => OpenAwardDialog(badge)" FullWidth="true" Class="specials__award">
                                    @L["Award"]
                                </MudButton>
                                @RenderActions($"onetime-{badge.Id}", () => OpenOneTimeDialog(badge), e => OnOneTimeBadgeImageSelected(e, badge.Id), () => DeleteOneTimeBadge(badge))
                            }
                        </div>
                    }
                </div>
            }
        </ChildContent>
    </SectionCard>
</div>

@code {
    [Parameter] public int ClubId { get; set; }

    [Inject] private IBadgesStore BadgesStore { get; set; } = null!;
    [Inject] private IClubStore ClubStore { get; set; } = null!;
    [Inject] private IClubProfileStore ClubProfileStore { get; set; } = null!;
    [Inject] private IStringLocalizer<BadgeSettingsLocale> L { get; set; } = null!;
    [Inject] private IStringLocalizer<SharedLocale> SharedLocale { get; set; } = null!;
    [Inject] private IStringLocalizer<BackendErrorCodeLocale> BackendLocale { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = null!;

    private const long MaxImageSize = 5 * 1024 * 1024;

    private int? selectedSeasonId;

    private bool isAdmin => ClubProfileStore.Roles.Contains(MemberRole.Admin);

    private bool canManageOneTimeBadges => isAdmin
                                           || ClubProfileStore.Roles.Contains(MemberRole.SportsDirector)
                                           || ClubProfileStore.Roles.Contains(MemberRole.YouthSportsDirector);

    private List<SeasonResult> SeasonsNewestFirst => ClubStore.Seasons.OrderByDescending(s => s.StartDate).ToList();

    private string SeasonText => ClubStore.Seasons.FirstOrDefault(s => s.Id == selectedSeasonId) is { } season
        ? string.Format(L["SeasonName"], MemberAdminHelpers.SeasonLabel(season))
        : "";

    protected override async Task OnInitializedAsync()
    {
        BadgesStore.OnBadgeTiersChanged += OnChanged;
        BadgesStore.OnOneTimeBadgesChanged += OnChanged;
        await ClubStore.LoadSeasons();

        selectedSeasonId = (ClubStore.Seasons.FirstOrDefault(s => s.IsActive) ?? SeasonsNewestFirst.FirstOrDefault())?.Id;
        if (selectedSeasonId is { } seasonId)
            await Task.WhenAll(BadgesStore.LoadBadgeTiers(seasonId), BadgesStore.LoadOneTimeBadges(seasonId));
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task OnSeasonChanged(int seasonId)
    {
        selectedSeasonId = seasonId;
        await Task.WhenAll(BadgesStore.LoadBadgeTiers(seasonId), BadgesStore.LoadOneTimeBadges(seasonId));
    }

    private RenderFragment RenderActions(string id, Func<Task> edit, Func<InputFileChangeEventArgs, Task> upload, Func<Task> delete) => __builder =>
    {
        <div class="tile-actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@SharedLocale["Edit"]" title="@SharedLocale["Edit"]" OnClick="edit" />
            <label for="@($"badge-upload-{id}")" class="tile-actions__upload" title="@L["UploadImage"]">
                <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Size="Size.Small" />
                <span class="visually-hidden">@L["UploadImage"]</span>
            </label>
            <InputFile id="@($"badge-upload-{id}")" OnChange="upload" accept="image/jpeg,image/png,image/webp,image/gif" style="display:none" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="@SharedLocale["Delete"]" title="@SharedLocale["Delete"]" OnClick="delete" />
        </div>
    };

    private Task OpenTierDetail(BadgeTierDto tier)
        => OpenDetail(new TrophyDetailDialog.BadgeDetailViewModel(tier.Name, tier.Description, tier.ImageUrl, tier.Level, null), TierFacts(tier));

    private Task OpenOneTimeDetail(OneTimeBadgeDto badge)
        => OpenDetail(new TrophyDetailDialog.BadgeDetailViewModel(badge.Name, badge.Description, badge.ImageUrl, null, null), OneTimeFacts(badge));

    private RenderFragment TierFacts(BadgeTierDto tier) => __builder =>
    {
        <div class="trophy-detail__fact"><span aria-hidden="true">🎾</span><span>@string.Format(L["MatchesRule"], tier.MatchesRequired)</span></div>
        <div class="trophy-detail__fact"><span aria-hidden="true">👥</span><span>@string.Format(L["EarnedBy"], tier.EarnedCount)</span></div>
    };

    private RenderFragment OneTimeFacts(OneTimeBadgeDto badge) => __builder =>
    {
        if (badge.Awardees.Count == 0)
        {
            <div class="trophy-detail__fact"><span aria-hidden="true">👥</span><span>@L["NotAwardedYet"]</span></div>
        }

        foreach (var awardee in badge.Awardees.OrderBy(a => a.AwardedAt))
        {
            <div class="trophy-detail__fact">
                <span aria-hidden="true">🏅</span>
                <span>@awardee.FirstName @awardee.LastName · @awardee.AwardedAt.ToLocalTime().ToString("d", CultureInfo.CurrentCulture)</span>
            </div>
        }
    };

    private Task OpenDetail(TrophyDetailDialog.BadgeDetailViewModel badge, RenderFragment facts)
    {
        var parameters = new DialogParameters<TrophyDetailDialog>
        {
            { x => x.Badge, badge },
            { x => x.SeasonLabel, SeasonText },
            { x => x.ClubName, ClubProfileStore.SelectedClub?.ClubName ?? "" },
            { x => x.Facts, facts },
        };
        return DialogService.ShowAsync<TrophyDetailDialog>(string.Empty, parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, NoHeader = true, CloseOnEscapeKey = true, BackdropClick = true });
    }

    private async Task OpenTierDialog(BadgeTierDto? tier)
    {
        if (selectedSeasonId is not { } seasonId)
            return;

        var parameters = new DialogParameters<CreateBadgeTierDialog> { { d => d.SeasonId, seasonId }, { d => d.Tier, tier } };
        await DialogService.ShowAsync<CreateBadgeTierDialog>(tier is null ? L["AddTier"] : string.Format(L["EditTitle"], tier.Name), parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
    }

    private async Task OpenOneTimeDialog(OneTimeBadgeDto? badge)
    {
        if (selectedSeasonId is not { } seasonId)
            return;

        var parameters = new DialogParameters<CreateOneTimeBadgeDialog> { { d => d.SeasonId, seasonId }, { d => d.Badge, badge } };
        await DialogService.ShowAsync<CreateOneTimeBadgeDialog>(badge is null ? L["AddOneTimeBadge"] : string.Format(L["EditTitle"], badge.Name), parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
    }

    private async Task OpenCopyTiersDialog()
    {
        if (selectedSeasonId is not { } seasonId)
            return;

        var parameters = new DialogParameters<CopyBadgeTiersDialog>
        {
            { d => d.TargetSeasonId, seasonId },
            { d => d.AvailableSourceSeasons, ClubStore.Seasons.Where(s => s.Id != seasonId).ToList() },
        };
        await DialogService.ShowAsync<CopyBadgeTiersDialog>(L["CopyTiers"], parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
    }

    private async Task OpenCopyOneTimeBadgesDialog()
    {
        if (selectedSeasonId is not { } seasonId)
            return;

        var parameters = new DialogParameters<CopyOneTimeBadgesDialog>
        {
            { d => d.TargetSeasonId, seasonId },
            { d => d.AvailableSourceSeasons, ClubStore.Seasons.Where(s => s.Id != seasonId).ToList() },
        };
        await DialogService.ShowAsync<CopyOneTimeBadgesDialog>(L["CopyOneTime"], parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
    }

    private async Task OpenAwardDialog(OneTimeBadgeDto badge)
    {
        if (selectedSeasonId is not { } seasonId)
            return;

        await BadgesStore.LoadSeasonClubMembers(seasonId);

        var parameters = new DialogParameters<AwardOneTimeBadgeDialog>
        {
            { d => d.OneTimeBadgeId, badge.Id },
            { d => d.AvailablePlayers, BadgesStore.SeasonClubMembers?.Members ?? [] },
            { d => d.CurrentAwardees, badge.Awardees },
        };
        await DialogService.ShowAsync<AwardOneTimeBadgeDialog>(string.Format(L["AwardTitle"], badge.Name), parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
    }

    private async Task DeleteTier(BadgeTierDto tier)
    {
        var confirmed = await DialogService.ShowMessageBox(SharedLocale["Delete"], string.Format(L["DeleteTierConfirmation"], tier.Name),
            yesText: SharedLocale["Delete"], cancelText: SharedLocale["Cancel"]);

        if (confirmed != true)
            return;

        var result = await BadgesStore.DeleteBadgeTier(tier.Id);
        if (!result.Success)
            Snackbar.ShowErrorDetails(result, BackendLocale);
    }

    private async Task DeleteOneTimeBadge(OneTimeBadgeDto badge)
    {
        var confirmed = await DialogService.ShowMessageBox(SharedLocale["Delete"], string.Format(L["DeleteOneTimeConfirmation"], badge.Name),
            yesText: SharedLocale["Delete"], cancelText: SharedLocale["Cancel"]);

        if (confirmed != true)
            return;

        var result = await BadgesStore.DeleteOneTimeBadge(badge.Id);
        if (!result.Success)
            Snackbar.ShowErrorDetails(result, BackendLocale);
    }

    private Task OnTierImageSelected(InputFileChangeEventArgs e, int tierId)
        => UploadImage(e, (stream, name, type) => BadgesStore.UploadBadgeTierImage(tierId, stream, name, type));

    private Task OnOneTimeBadgeImageSelected(InputFileChangeEventArgs e, int badgeId)
        => UploadImage(e, (stream, name, type) => BadgesStore.UploadOneTimeBadgeImage(badgeId, stream, name, type));

    private async Task UploadImage(InputFileChangeEventArgs e, Func<Stream, string, string, Task<Bookennis.Client.Services.HttpClients.HttpResult>> upload)
    {
        var file = e.File;
        if (file.Size > MaxImageSize)
        {
            Snackbar.Add(L["ImageTooLarge"], Severity.Warning);
            return;
        }

        await using var stream = file.OpenReadStream(MaxImageSize);
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        memoryStream.Position = 0;

        var result = await upload(memoryStream, file.Name, file.ContentType);
        if (result.Success)
            Snackbar.Add(L["ImageUploaded"], Severity.Success);
        else
            Snackbar.ShowErrorDetails(result, BackendLocale);
    }

    public void Dispose()
    {
        BadgesStore.OnBadgeTiersChanged -= OnChanged;
        BadgesStore.OnOneTimeBadgesChanged -= OnChanged;
    }
}
