@page "/clubs/{ClubId:int}/calendar/{ClubEventId:int}"
@using Bookennis.Client.Components.Shared
@using Bookennis.Client.Localization
@using Bookennis.Client.Localization.Pages.Calendar
@using Bookennis.Client.Pages.ClubShell.Calendar.Components
@using Bookennis.Client.Pages.ClubShell.News.Components
@using Bookennis.Client.Services
@using Bookennis.Client.Services.Store.ClubEvents
@using Bookennis.Client.Services.Store.ClubProfile
@using Bookennis.Client.Utils
@using Bookennis.Shared.Controller.ClubEvents

@implements IDisposable

<PageTitle>@(Event?.Title ?? Locale["Calendar"])</PageTitle>

<div class="mb-2">
    <MudButton Href="@ClubEventHelpers.CalendarUrl(ClubId)" Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack">
        @Locale["BackToCalendar"]
    </MudButton>
</div>

@if (Event is null)
{
    @if (notFound)
    {
        <div class="event-empty">
            <div class="event-empty__emoji" aria-hidden="true">🔍</div>
            <div class="event-empty__title">@Locale["EventNotFound"]</div>
        </div>
    }
    else
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }
}
else
{
    var clubEvent = Event;
    <div class="event-page">
        <MudGrid Spacing="3">
            <MudItem xs="12">
                <div class="event-hero" style="--event-color: @ClubEventHelpers.Color(clubEvent.Category)">
                    <div class="event-hero__text">
                        <div class="event-hero__chips">
                            <span class="hero-chip">@ClubEventHelpers.Emoji(clubEvent.Category) @ClubEventHelpers.CategoryName(Locale, clubEvent.Category)</span>
                            @if (!clubEvent.IsOver)
                            {
                                <span class="hero-chip">⏳ @ClubEventHelpers.Countdown(Locale, clubEvent.StartDate, clubEvent.LastDate)</span>
                            }
                            else
                            {
                                <span class="hero-chip">🕰️ @Locale["Past"]</span>
                            }
                        </div>
                        <h1 class="event-hero__title">@clubEvent.Title</h1>
                        <div class="event-hero__facts">
                            <div>📅 @ClubEventHelpers.FormatDateRange(Locale, clubEvent.StartDate, clubEvent.EndDate, withYear: true)</div>
                            <div>🕘 @ClubEventHelpers.FormatTime(Locale, clubEvent.StartTime, clubEvent.EndTime)</div>
                            @if (!string.IsNullOrWhiteSpace(clubEvent.Location))
                            {
                                <div>📍 @clubEvent.Location</div>
                            }
                            @if (clubEvent.CreatedByName is not null)
                            {
                                <div class="event-hero__organizer">@string.Format(Locale["OrganizedBy"], clubEvent.CreatedByName)</div>
                            }
                        </div>
                    </div>

                    <div class="event-hero__actions">
                        <MudButton Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.Share" Class="event-hero__button" OnClick="Share">
                            @Locale["Share"]
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Custom.Brands.WhatsApp" Class="event-hero__button"
                                   Href="@WhatsAppUrl" Target="_blank" rel="noopener">
                            WhatsApp
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.Link" Class="event-hero__button" OnClick="CopyLink">
                            @Locale["CopyLink"]
                        </MudButton>
                        @if (CanManage)
                        {
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Class="event-hero__menu" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                                     aria-label="@Locale["OrganizerActions"]">
                                <MudMenuItem Icon="@Icons.Material.Filled.Edit" Href="@($"{ClubEventHelpers.EventUrl(ClubId, clubEvent.Id)}/edit")">
                                    @Locale["EditEvent"]
                                </MudMenuItem>
                                @if (clubEvent.RegistrationEnabled)
                                {
                                    <MudMenuItem Icon="@Icons.Material.Filled.Download" OnClick="Export">@Locale["ExportParticipants"]</MudMenuItem>
                                }
                                <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="Delete">@Locale["DeleteEvent"]</MudMenuItem>
                            </MudMenu>
                        }
                    </div>
                </div>
            </MudItem>

            <MudItem xs="12" md="7">
                <div class="event-stack">
                    @if (!string.IsNullOrWhiteSpace(clubEvent.DescriptionHtml))
                    {
                        <SectionCard Emoji="📝" Title="@Locale["About"]">
                            <AnnouncementBody Html="@clubEvent.DescriptionHtml" />
                        </SectionCard>
                    }

                    @if (clubEvent.RegistrationEnabled)
                    {
                        <RegistrationForm Event="@clubEvent" />
                    }
                    else if (string.IsNullOrWhiteSpace(clubEvent.DescriptionHtml))
                    {
                        <SectionCard Emoji="ℹ️" Title="@Locale["About"]">
                            <div class="event-muted">@Locale["NoRegistrationNeeded"]</div>
                        </SectionCard>
                    }
                </div>
            </MudItem>

            @if (clubEvent.RegistrationEnabled)
            {
                <MudItem xs="12" md="5">
                    <div class="event-stack">
                        <SectionCard Emoji="👥" Title="@Locale["Participants"]"
                                     Subtitle="@($"{ClubEventHelpers.Count(Locale, "PeopleCount", clubEvent.TotalHeadCount)} · {ClubEventHelpers.Count(Locale, "RegistrationCount", clubEvent.Registrations.Count)}")">
                            @if (clubEvent.MaxParticipants is { } max)
                            {
                                <div class="event-capacity">
                                    <MudProgressLinear Value="@(Math.Min(100, clubEvent.TotalHeadCount * 100.0 / max))" Rounded="true" Size="Size.Medium"
                                                       Color="@(clubEvent.IsFull ? Color.Error : Color.Primary)" />
                                    <span class="event-capacity__label">@string.Format(Locale["CapacityLabel"], clubEvent.TotalHeadCount, max)</span>
                                </div>
                            }

                            @if (clubEvent.Registrations.Count == 0)
                            {
                                <div class="event-muted">@Locale["NoParticipantsYet"]</div>
                            }
                            else
                            {
                                @foreach (var registration in clubEvent.Registrations)
                                {
                                    var answers = AnswerSummary(clubEvent, registration);
                                    <div class="participant @(registration.MemberId == clubEvent.MyRegistration?.MemberId ? "participant--me" : null)">
                                        <UserAvatar FirstName="@registration.FirstName" LastName="@registration.LastName" ProfilePictureUrl="@registration.ProfilePictureUrl"
                                                    Size="Size.Medium" Color="Color.Secondary" />
                                        <div class="participant__body">
                                            <div class="participant__name">
                                                @registration.FirstName @registration.LastName
                                                @if (registration.HeadCount > 1)
                                                {
                                                    <span class="participant__plus">+@(registration.HeadCount - 1)</span>
                                                }
                                            </div>
                                            @if (answers.Length > 0)
                                            {
                                                <div class="participant__answers">@answers</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(registration.Comment))
                                            {
                                                <div class="participant__comment">“@registration.Comment”</div>
                                            }
                                        </div>
                                        @if (CanManage)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.PersonRemove" Size="Size.Small" Color="Color.Default"
                                                           aria-label="@Locale["RemoveRegistration"]" title="@Locale["RemoveRegistration"]"
                                                           Disabled="@Store.IsSaving" OnClick="() => RemoveRegistration(registration)" />
                                        }
                                    </div>
                                }
                            }
                        </SectionCard>

                        @if (clubEvent.Questions.Count > 0)
                        {
                            <SectionCard Emoji="🧮" Title="@Locale["Totals"]" Subtitle="@Locale["TotalsSubtitle"]">
                                @foreach (var question in clubEvent.Questions)
                                {
                                    var maxTotal = Math.Max(1, question.Options.Max(o => o.Total));
                                    <div class="totals-question">
                                        <div class="totals-question__text">@question.Text</div>
                                        @foreach (var option in question.Options)
                                        {
                                            <div class="totals-option">
                                                <span class="totals-option__label">@option.Label</span>
                                                <span class="totals-option__bar">
                                                    <span class="totals-option__fill" style="width: @((option.Total * 100 / maxTotal).ToString())%"></span>
                                                </span>
                                                <span class="totals-option__value">@option.Total</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </SectionCard>
                        }
                    </div>
                </MudItem>
            }
        </MudGrid>
    </div>
}

@code {
    [Parameter] public int ClubId { get; set; }
    [Parameter] public int ClubEventId { get; set; }

    [Inject] private IClubEventsStore Store { get; set; } = null!;
    [Inject] private IClubProfileStore ClubProfileStore { get; set; } = null!;
    [Inject] private NavigationManager NavigationManager { get; set; } = null!;
    [Inject] private IJSRuntime JsRuntime { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = null!;
    [Inject] private IStringLocalizer<CalendarLocale> Locale { get; set; } = null!;
    [Inject] private IStringLocalizer<SharedLocale> SharedLocale { get; set; } = null!;
    [Inject] private IStringLocalizer<BackendErrorCodeLocale> BackendLocale { get; set; } = null!;

    private bool notFound;

    private ClubEventDto? Event => Store.Event?.Id == ClubEventId ? Store.Event : null;

    private bool CanManage => ClubEventHelpers.CanManage(ClubProfileStore.Roles);

    private string EventUrl => ClubEventHelpers.AbsoluteEventUrl(NavigationManager, ClubId, ClubEventId);

    private string WhatsAppUrl => Event is null
        ? "#"
        : $"https://wa.me/?text={Uri.EscapeDataString(ClubEventHelpers.ShareText(Locale, Event, EventUrl, forWhatsApp: true))}";

    protected override void OnInitialized()
    {
        Store.OnEventChanged += StateHasChanged;
        ClubProfileStore.OnClubProfileChanged += StateHasChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        notFound = false;
        await Store.LoadEvent(ClubEventId);
        notFound = Store.Event?.Id != ClubEventId;
    }

    private static string AnswerSummary(ClubEventDto clubEvent, ClubEventRegistrationDto registration)
    {
        var quantities = registration.Answers.ToDictionary(a => a.OptionId, a => a.Quantity);
        var parts = clubEvent.Questions
            .SelectMany(q => q.Options.Where(o => quantities.ContainsKey(o.Id))
                .Select(o => q.AllowQuantities ? $"{quantities[o.Id]}× {o.Label}" : o.Label));
        return string.Join(" · ", parts);
    }

    private async Task Share()
    {
        if (Event is null)
            return;

        try
        {
            var result = await JsRuntime.InvokeAsync<string>("App.shareOrCopy", Event.Title, ClubEventHelpers.ShareText(Locale, Event, EventUrl), EventUrl);
            if (result == "copied")
                Snackbar.Add(Locale["LinkCopied"], Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add(Locale["ShareFailed"], Severity.Warning);
        }
    }

    private async Task CopyLink()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("App.copyToClipboard", EventUrl);
            Snackbar.Add(Locale["LinkCopied"], Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add(Locale["ShareFailed"], Severity.Warning);
        }
    }

    private async Task Export()
    {
        var result = await Store.ExportParticipants(ClubEventId);
        if (result is not { Success: true, Dto: not null })
        {
            Snackbar.ShowErrorDetails(result, BackendLocale);
            return;
        }

        using var streamReference = new DotNetStreamReference(new MemoryStream(result.Dto.Data));
        await JsRuntime.InvokeVoidAsync("App.downloadFileFromStream", result.Dto.FileName, streamReference);
    }

    private async Task Delete()
    {
        if (Event is null)
            return;

        var message = Event.Registrations.Count > 0
            ? string.Format(Locale["DeleteEventConfirmWithRegistrations"], Event.Title, Event.Registrations.Count)
            : string.Format(Locale["DeleteEventConfirm"], Event.Title);
        var confirmed = await DialogService.ShowMessageBox(Locale["DeleteEvent"], message, yesText: SharedLocale["Delete"], cancelText: SharedLocale["Cancel"]);
        if (confirmed != true)
            return;

        var result = await Store.DeleteEvent(ClubEventId);
        if (!result.Success)
        {
            Snackbar.ShowErrorDetails(result, BackendLocale);
            return;
        }

        Snackbar.Add(Locale["EventDeleted"], Severity.Success);
        NavigationManager.NavigateTo(ClubEventHelpers.CalendarUrl(ClubId));
    }

    private async Task RemoveRegistration(ClubEventRegistrationDto registration)
    {
        var confirmed = await DialogService.ShowMessageBox(Locale["RemoveRegistration"],
            string.Format(Locale["RemoveRegistrationConfirm"], $"{registration.FirstName} {registration.LastName}"),
            yesText: Locale["Remove"], cancelText: SharedLocale["Cancel"]);
        if (confirmed != true)
            return;

        var result = await Store.RemoveRegistration(ClubEventId, registration.Id);
        if (!result.Success)
            Snackbar.ShowErrorDetails(result, BackendLocale);
    }

    public void Dispose()
    {
        Store.OnEventChanged -= StateHasChanged;
        ClubProfileStore.OnClubProfileChanged -= StateHasChanged;
    }
}
