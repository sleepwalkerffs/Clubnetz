@using Bookennis.Client.Components.Shared.Dialogs
@using Bookennis.Client.Localization
@using Bookennis.Client.Localization.Pages.Accounting
@using Bookennis.Client.Services.Store.Accounting
@using Bookennis.Client.Utils
@using Bookennis.Shared.Controller.Accounting

@* Which payments Clubnetz turns into entries: per source off, as suggestions to review, or booked right away, and in each source the
   money accounts its payments are booked into by the way they were paid. The accounts are shared (cash is the same cash box for the
   membership fees and the clubhouse), so a row says which other sources use it too. *@

<BaseDialog SubmitFunc="Submit" SubmitCaption="@SharedLocale["Save"]" CancelFunc="Cancel" CancelCaption="@SharedLocale["Cancel"]"
            Loading="@Store.IsSaving" Title="@L["Automation_Title"]">
    @if (!loaded)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <div class="automation-form">
            <div class="automation-form__hint">@L["Automation_Hint"]</div>

            @foreach (var source in sources)
            {
                var current = source;
                var on = current.Mode != AccountingAutomationMode.Off;
                <div class="automation-source @(on ? "automation-source--on" : null)">
                    <div class="automation-source__head">
                        <span class="automation-source__emoji" aria-hidden="true">@Emoji(current.Source)</span>
                        <span class="automation-source__text">
                            <span class="automation-source__title">@L[$"Source_{current.Source}"]</span>
                            <span class="automation-source__desc">@L[$"SourceHint_{current.Source}"]</span>
                        </span>
                    </div>
                    <MudToggleGroup T="AccountingAutomationMode" @bind-Value="current.Mode" Color="Color.Primary" Size="Size.Small" Dense="true" FixedContent="true" Class="automation-source__modes">
                        @foreach (var mode in Enum.GetValues<AccountingAutomationMode>())
                        {
                            <MudToggleItem Value="@mode" Text="@L[$"Mode_{mode}"]" />
                        }
                    </MudToggleGroup>
                    @if (on)
                    {
                        <div class="automation-source__fields">
                            <MudSelect T="int?" @bind-Value="current.CategoryId" Label="@L[current.Source == AccountingSource.Stripe ? "Automation_FeeCategory" : "Category"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var category in Categories(current.Source))
                                {
                                    <MudSelectItem T="int?" Value="@category.Id">@AccountingHelpers.CategoryName(category)</MudSelectItem>
                                }
                            </MudSelect>
                            <MudDatePicker Date="@current.Since" DateChanged="d => current.Since = d" Label="@L["Automation_Since"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           HelperText="@L["Automation_SinceHint"]" />
                        </div>
                        <div class="automation-source__subtitle">@L["Automation_BookedInto"]</div>
                        <div class="automation-source__accounts">
                            @foreach (var row in Rows(current.Source))
                            {
                                var slot = row.Slot;
                                <AccountSelect Label="@L[row.Label]" Hint="@RowHint(current.Source, slot)" Accounts="@Accounts(slot)" Value="@Get(slot)"
                                               ValueChanged="v => Set(slot, v)" Required="true" Invalid="@(slot == Slot.Online && OnlineIsNoProvider)" />
                            }
                        </div>
                        @if (current.Mode == AccountingAutomationMode.Book)
                        {
                            <div class="automation-source__note">@L["Mode_BookHint"]</div>
                        }
                    }
                </div>
            }

            @if (Missing is { } missing)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@missing</MudAlert>
            }
        </div>
    }
</BaseDialog>

@code {
    private sealed class SourceInput
    {
        public AccountingSource Source { get; init; }
        public AccountingAutomationMode Mode { get; set; }
        public DateTime? Since { get; set; }
        public int? CategoryId { get; set; }
    }

    [Inject] private IAccountingStore Store { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private IStringLocalizer<AccountingLocale> L { get; set; } = null!;
    [Inject] private IStringLocalizer<SharedLocale> SharedLocale { get; set; } = null!;
    [Inject] private IStringLocalizer<BackendErrorCodeLocale> BackendLocale { get; set; } = null!;

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = null!;

    private bool loaded;
    private bool stripeConnected;
    private List<SourceInput> sources = [];
    private int? online;
    private int? bank;
    private int? cash;
    private int? card;

    /// <summary>The money accounts the payments are booked into, by the way they were paid (one setting each, used by several sources).</summary>
    private enum Slot { Online, Bank, Cash, Card }

    /// <summary>The accounts a source books into, as the server does (online membership fees only with Stripe connected).</summary>
    private IEnumerable<(Slot Slot, string Label)> Rows(AccountingSource source) => source switch
    {
        AccountingSource.MembershipFees when stripeConnected => [(Slot.Online, "Booked_Online"), (Slot.Bank, "Booked_Bank"), (Slot.Cash, "Booked_Cash")],
        AccountingSource.MembershipFees => [(Slot.Bank, "Booked_Bank"), (Slot.Cash, "Booked_Cash")],
        AccountingSource.CourtSales => [(Slot.Online, "Booked_Online")],
        AccountingSource.Clubhouse => [(Slot.Cash, "Booked_Cash"), (Slot.Card, "Booked_Card")],
        _ => [(Slot.Online, "Booked_StripeBalance"), (Slot.Bank, "Booked_Payouts")],
    };

    private bool Needs(Slot slot) => sources.Any(s => s.Mode != AccountingAutomationMode.Off && Rows(s.Source).Any(r => r.Slot == slot));

    private int? Get(Slot slot) => slot switch { Slot.Online => online, Slot.Bank => bank, Slot.Cash => cash, _ => card };

    private void Set(Slot slot, int? value)
    {
        switch (slot)
        {
            case Slot.Online: online = value; break;
            case Slot.Bank: bank = value; break;
            case Slot.Cash: cash = value; break;
            default: card = value; break;
        }
    }

    /// <summary>Online payments wait at Stripe until the payout: they belong in a payment provider account, not in the bank.</summary>
    private bool OnlineIsNoProvider
        => online is { } id && Store.Basics?.MoneyAccounts.FirstOrDefault(a => a.Id == id)?.Kind is { } kind && kind != MoneyAccountKind.PaymentProvider;

    /// <summary>What to look out for in the row, and the other switched-on sources that book into the same account.</summary>
    private string? RowHint(AccountingSource source, Slot slot)
    {
        if (slot == Slot.Online && (OnlineIsNoProvider || Accounts(slot).Count == 0))
            return L[Accounts(slot).Any(a => a.Kind == MoneyAccountKind.PaymentProvider) ? "Automation_OnlineKind" : "Automation_NoProvider"];

        var others = sources.Where(s => s.Source != source && s.Mode != AccountingAutomationMode.Off && Rows(s.Source).Any(r => r.Slot == slot))
            .Select(s => L[$"Source_{s.Source}"].Value)
            .ToList();
        var also = others.Count > 0 ? string.Format(L["Automation_AlsoFor"], string.Join(", ", others)) : null;
        return slot == Slot.Card ? string.Join(" · ", new[] { L["Automation_CardHint"].Value, also }.OfType<string>()) : also;
    }

    /// <summary>What is still missing for the sources that are on (the server says the same with an error).</summary>
    private string? Missing
    {
        get
        {
            if (sources.Any(s => s.Mode != AccountingAutomationMode.Off && s.CategoryId is null))
                return L["Automation_MissingCategory"];
            if (Enum.GetValues<Slot>().Any(slot => Needs(slot) && Get(slot) is null))
                return L["Automation_MissingAccount"];
            if (Needs(Slot.Online) && OnlineIsNoProvider)
                return L["Automation_OnlineKind"];
            return null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Store.LoadAutomation();
        var automation = Store.Automation;
        var basics = Store.Basics;
        stripeConnected = automation?.StripeConnected == true;
        online = automation?.OnlineMoneyAccountId ?? basics?.MoneyAccounts.FirstOrDefault(a => a.Kind == MoneyAccountKind.PaymentProvider && !a.IsArchived)?.Id;
        bank = automation?.BankMoneyAccountId ?? basics?.MoneyAccounts.FirstOrDefault(a => a.Kind == MoneyAccountKind.Bank && !a.IsArchived)?.Id;
        cash = automation?.CashMoneyAccountId ?? basics?.MoneyAccounts.FirstOrDefault(a => a.Kind == MoneyAccountKind.Cash && !a.IsArchived)?.Id;
        card = automation?.CardMoneyAccountId;

        sources = Enum.GetValues<AccountingSource>().Select(source =>
        {
            var setting = automation?.Sources.FirstOrDefault(s => s.Source == source);
            return new SourceInput
            {
                Source = source,
                Mode = setting?.Mode ?? AccountingAutomationMode.Off,
                Since = (setting?.Since ?? DateOnly.FromDateTime(DateTime.Today)).ToDateTime(TimeOnly.MinValue),
                CategoryId = setting?.CategoryId ?? DefaultCategory(source),
            };
        }).ToList();
        loaded = true;
    }

    /// <summary>The category of the Austrian template that fits the source (the treasurer may pick another one).</summary>
    private int? DefaultCategory(AccountingSource source)
    {
        var number = source switch
        {
            AccountingSource.MembershipFees => "4000",
            AccountingSource.CourtSales => "4100",
            AccountingSource.Clubhouse => "4300",
            _ => "5710",
        };
        return Categories(source).FirstOrDefault(c => c.Number == number)?.Id;
    }

    private IEnumerable<AccountingCategoryDto> Categories(AccountingSource source)
    {
        var kind = source == AccountingSource.Stripe ? AccountingCategoryKind.Expense : AccountingCategoryKind.Income;
        return (Store.Basics?.Categories ?? []).Where(c => c.Kind == kind && !c.IsArchived);
    }

    /// <summary>The accounts to choose from: for online payments only payment providers (and the one chosen before, so it can be changed).</summary>
    private List<MoneyAccountDto> Accounts(Slot slot) => (Store.Basics?.MoneyAccounts ?? [])
        .Where(a => a.Id == Get(slot) || !a.IsArchived && (slot != Slot.Online || a.Kind == MoneyAccountKind.PaymentProvider))
        .ToList();

    private static string Emoji(AccountingSource source) => source switch
    {
        AccountingSource.MembershipFees => "🎫",
        AccountingSource.CourtSales => "🎾",
        AccountingSource.Clubhouse => "🍺",
        _ => "💳",
    };

    private async Task<DialogResult?> Submit()
    {
        if (Missing is not null)
            return null;

        var result = await Store.SaveAutomation(new SaveAccountingAutomationModel
        {
            OnlineMoneyAccountId = online,
            BankMoneyAccountId = bank,
            CashMoneyAccountId = cash,
            CardMoneyAccountId = card,
            Sources = sources.Select(s => new AccountingSourceSettingDto
            {
                Source = s.Source,
                Mode = s.Mode,
                Since = s.Since is { } since ? DateOnly.FromDateTime(since) : null,
                CategoryId = s.CategoryId,
            }).ToList(),
        });
        if (!result.Success)
        {
            Snackbar.ShowErrorDetails(result, BackendLocale);
            return null;
        }

        Snackbar.Add(L["Saved"], Severity.Success);
        if (sources.Any(s => s.Mode != AccountingAutomationMode.Off))
            await Store.SyncProposals();
        return DialogResult.Ok(true);
    }

    private Task<DialogResult?> Cancel()
    {
        MudDialog.Cancel();
        return Task.FromResult<DialogResult?>(null);
    }
}
