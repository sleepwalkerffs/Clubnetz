@using System.ComponentModel.DataAnnotations
@using Bookennis.Client.Components.Shared.Buttons
@using Bookennis.Client.Components.Shared.Dialogs
@using Bookennis.Client.Localization
@using Bookennis.Client.Localization.Pages.Account
@using Bookennis.Client.Services.Store.Profile
@using Bookennis.Client.Utils

@implements IDisposable

<BaseDialog Title="@Locale["ChangePassword"]"
            SubmitFunc="Submit"
            SubmitCaption="@Locale["SaveNewPassword"]"
            CancelFunc="Cancel"
            CancelCaption="@SharedLocale["Cancel"]"
            Loading="@saving">
    <EditForm EditContext="@context">
        <DataAnnotationsValidator />
        <div class="d-flex flex-column gap-3">
            <PasswordField TType="string" Label="@Locale["CurrentPassword"]" AutoComplete="current-password"
                           @bind-Value="model.CurrentPassword" For="@(() => model.CurrentPassword)" />
            <PasswordField TType="string" Label="@Locale["NewPassword"]" AutoComplete="new-password" Immediate="true"
                           @bind-Value="model.Password" For="@(() => model.Password)" />
            <PasswordRequirements Password="@model.Password" />
            <PasswordField TType="string" Label="@Locale["RepeatNewPassword"]" AutoComplete="new-password"
                           @bind-Value="model.Password2" For="@(() => model.Password2)" />
        </div>
    </EditForm>
</BaseDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = null!;

    [Inject] private IProfileStore ProfileStore { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private IStringLocalizer<AccountLocale> Locale { get; set; } = null!;
    [Inject] private IStringLocalizer<SharedLocale> SharedLocale { get; set; } = null!;
    [Inject] private IStringLocalizer<BackendErrorCodeLocale> BackendLocale { get; set; } = null!;

    private readonly ChangePasswordForm model = new();
    private EditContext context = null!;
    private bool saving;
    private ValidationMessageStore messageStore = null!;

    protected override void OnInitialized()
    {
        context = new EditContext(model);
        context.OnValidationRequested += HandleValidationRequested;
        messageStore = new ValidationMessageStore(context);
    }

    private async Task<DialogResult?> Submit()
    {
        if (!context.Validate())
            return null;

        saving = true;
        StateHasChanged();
        try
        {
            var result = await ProfileStore.ChangePassword(model.CurrentPassword!, model.Password!);
            if (!result.Success)
            {
                Snackbar.ShowErrorDetails(result, BackendLocale);
                return null;
            }

            return DialogResult.Ok(true);
        }
        finally
        {
            saving = false;
            StateHasChanged();
        }
    }

    private Task<DialogResult?> Cancel() => Task.FromResult<DialogResult?>(DialogResult.Cancel());

    private void HandleValidationRequested(object? sender, ValidationRequestedEventArgs args)
    {
        messageStore.Clear();
        if (model.Password == null)
            return;

        foreach (var error in PasswordValidation.ValidatePassword(model.Password, Locale))
            messageStore.Add(() => model.Password, error);
    }

    public void Dispose() => context.OnValidationRequested -= HandleValidationRequested;

    private class ChangePasswordForm
    {
        [Required(ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "PasswordValidation")]
        public string? CurrentPassword { get; set; }

        [Required(ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "PasswordValidation"),
         StringLength(PasswordValidation.MaxLength, MinimumLength = PasswordValidation.MinLength, ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "PasswordLength")]
        public string? Password { get; set; }

        [Required(ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "PasswordValidation")]
        [Compare(nameof(Password), ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "Password2Validation")]
        public string? Password2 { get; set; }
    }
}
