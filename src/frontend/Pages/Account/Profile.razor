@page "/account/profile";
@layout AuthorizedLayout;
@attribute [Authorize];

@using Bookennis.Client.Components.Shared
@using Bookennis.Client.Components.Shared.Buttons
@using Bookennis.Client.Components.Shared.Dialogs
@using Bookennis.Client.Localization
@using Bookennis.Client.Localization.Pages.Account
@using Bookennis.Client.Pages.Account.Components
@using Bookennis.Client.Pages.Account.Dialogs
@using Bookennis.Client.Services
@using Bookennis.Client.Services.HttpClients.Profile
@using Bookennis.Client.Services.Store.ClubProfile
@using Bookennis.Client.Services.Store.Profile
@using Bookennis.Client.Shared
@using Bookennis.Client.Utils
@using Bookennis.Shared.Controller.Profile
@using Bookennis.Shared.Controller.Shared
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations

@implements IDisposable

<PageTitle>@Locale["Profile"]</PageTitle>

<div class="profile-page">
    <div class="profile-head">
        <UserAvatar FirstName="@(model.FirstName ?? "")" LastName="@(model.LastName ?? "")" ProfilePictureUrl="@profilePictureUrl" Size="Size.Large" AvatarClass="profile-head__avatar" />
        <div class="profile-head__text">
            <div class="profile-head__name">@($"{model.FirstName} {model.LastName}")</div>
            <div class="profile-head__email">@model.Email</div>
            <label for="profilePictureInput" class="profile-head__upload">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" HtmlTag="span" StartIcon="@Icons.Material.Filled.PhotoCamera">
                    @Locale["UploadPhoto"]
                </MudButton>
            </label>
            <InputFile id="profilePictureInput" OnChange="OnProfilePictureSelected" accept="image/jpeg,image/png,image/webp,image/gif" style="display:none" />
        </div>
    </div>

    <EditForm Model="@model" OnValidSubmit="Submit">
        <DataAnnotationsValidator />
        <div class="profile-grid">
            <SectionCard Emoji="👤" Title="@Locale["GeneralInfo"]" Subtitle="@Locale["Profile_GeneralInfoSubtitle"]">
                <div class="profile-fields">
                    <MudTextField Variant="Variant.Outlined" T="string" Label=@SharedLocale["Firstname"] @bind-Value="model.FirstName" For="@(() => model.FirstName)" />
                    <MudTextField Variant="Variant.Outlined" T="string" Label=@SharedLocale["Lastname"] @bind-Value="model.LastName" For="@(() => model.LastName)" />
                    <MudDatePicker Variant="Variant.Outlined" PickerVariant="PickerVariant.Dialog" Label=@SharedLocale["Birthday"] @bind-Date="model.Birthday" For="(() => model.Birthday)" DateFormat="dd.MM.yyyy" />
                    <MudSelect T="int" Label=@SharedLocale["Gender"] Variant="Variant.Outlined" @bind-Value="model.Gender" For="@(() => model.Gender)">
                        <MudSelectItem T="int" Value="0">@SharedLocale["Mr"]</MudSelectItem>
                        <MudSelectItem T="int" Value="1">@SharedLocale["Mrs"]</MudSelectItem>
                        <MudSelectItem T="int" Value="2">@SharedLocale["None"]</MudSelectItem>
                    </MudSelect>
                    <div class="profile-fields__full">
                        <MudSelect T="int" Label=@SharedLocale["Language"] Variant="Variant.Outlined" @bind-Value="model.Language" For="@(() => model.Language)">
                            <MudSelectItem T="int" Value="0">@SharedLocale["German"]</MudSelectItem>
                            <MudSelectItem T="int" Value="1">@SharedLocale["English"]</MudSelectItem>
                        </MudSelect>
                    </div>
                </div>
            </SectionCard>

            <SectionCard Emoji="🏠" Title="@SharedLocale["Address"]" Subtitle="@Locale["Profile_AddressSubtitle"]">
                <div class="profile-fields">
                    <div class="profile-fields__full">
                        <MudTextField Variant="Variant.Outlined" T="string" Label=@SharedLocale["Street"] @bind-Value="model.Street" For="@(() => model.Street)" />
                    </div>
                    <MudTextField Variant="Variant.Outlined" T="string" Label=@SharedLocale["ZipCode"] @bind-Value="model.ZipCode" For="@(() => model.ZipCode)" />
                    <MudTextField Variant="Variant.Outlined" T="string" Label=@SharedLocale["City"] @bind-Value="model.City" For="@(() => model.City)" />
                    <div class="profile-fields__full">
                        <MudSelect T="int" Label=@SharedLocale["Country"] Variant="Variant.Outlined" @bind-Value="model.Country" For="@(() => model.Country)">
                            <MudSelectItem T="int" Value="0">@SharedLocale["Austria"]</MudSelectItem>
                            <MudSelectItem T="int" Value="1">@SharedLocale["Germany"]</MudSelectItem>
                            <MudSelectItem T="int" Value="2">@SharedLocale["Switzerland"]</MudSelectItem>
                        </MudSelect>
                    </div>
                </div>
            </SectionCard>
        </div>

        <div class="profile-actions">
            <LoadButton ButtonType="ButtonType.Submit"
                        FullWidth="false"
                        Variant="Variant.Filled"
                        Color="Color.Primary"
                        Loading="@processing"
                        Disabled="@processing">
                @SharedLocale["Save"]
            </LoadButton>
            <LoadButton Variant="Variant.Outlined"
                        FullWidth="false"
                        Color="Color.Secondary"
                        Disabled="@processing"
                        OnClick="Cancel">
                @SharedLocale["Cancel"]
            </LoadButton>
        </div>
    </EditForm>

    <AppAndNotificationsCard />

    <NotificationPreferencesCard />

    @if (!isGuestSession)
    {
        <SectionCard Emoji="🔐" Title="@Locale["Security_Title"]" Subtitle="@Locale["Security_Subtitle"]">
            <div class="security-list">
                <div class="security-row">
                    <MudIcon Icon="@Icons.Material.Filled.AlternateEmail" Size="Size.Small" Class="security-row__icon" />
                    <div class="security-row__text">
                        <div class="security-row__label">@Locale["Email"]</div>
                        <div class="security-row__value">@model.Email</div>
                    </div>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="OpenChangeEmail">@Locale["Change"]</MudButton>
                </div>
                @if (pendingEmail is not null)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="security-pending">
                        @string.Format(Locale["ChangeEmail_Pending"], pendingEmail)
                    </MudAlert>
                }
                <div class="security-row">
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="security-row__icon" />
                    <div class="security-row__text">
                        <div class="security-row__label">@Locale["Password"]</div>
                        <div class="security-row__value">••••••••</div>
                    </div>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="OpenChangePassword">@Locale["Change"]</MudButton>
                </div>
            </div>
        </SectionCard>

        <SectionCard Emoji="🛡️" Title="@Locale["Data_Title"]" Subtitle="@Locale["Data_Subtitle"]">
            <div class="security-list">
                <div class="security-row">
                    <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" Class="security-row__icon" />
                    <div class="security-row__text">
                        <div class="security-row__label">@Locale["Data_Export"]</div>
                        <div class="security-row__value">@Locale["Data_ExportDescription"]</div>
                    </div>
                    <LoadButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" FullWidth="false" Loading="@exporting" Disabled="@exporting" OnClick="ExportData">
                        @Locale["Data_Download"]
                    </LoadButton>
                </div>
                <div class="security-row">
                    <MudIcon Icon="@Icons.Material.Filled.Policy" Size="Size.Small" Class="security-row__icon" />
                    <div class="security-row__text">
                        <div class="security-row__label">@Locale["Data_Privacy"]</div>
                        <div class="security-row__value">@Locale["Data_PrivacyDescription"]</div>
                    </div>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Href="legal/privacy">@Locale["Data_Open"]</MudButton>
                </div>
            </div>
        </SectionCard>

        <SectionCard Emoji="⚠️" Title="@Locale["Danger_Title"]" Subtitle="@Locale["Danger_Subtitle"]" Class="profile-danger">
            <div class="security-list">
                @if (CanLeaveSelectedClub)
                {
                    <div class="security-row">
                        <MudIcon Icon="@Icons.Material.Filled.GroupRemove" Size="Size.Small" Class="security-row__icon security-row__icon--danger" />
                        <div class="security-row__text">
                            <div class="security-row__label">@Locale["LeaveClub"]</div>
                            <div class="security-row__value">@ClubProfileStore.SelectedClub!.ClubName</div>
                        </div>
                        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="LeaveClub">@Locale["LeaveClub_Button"]</MudButton>
                    </div>
                }
                <div class="security-row">
                    <MudIcon Icon="@Icons.Material.Filled.DeleteForever" Size="Size.Small" Class="security-row__icon security-row__icon--danger" />
                    <div class="security-row__text">
                        <div class="security-row__label">@Locale["DeleteAccount"]</div>
                        <div class="security-row__value">@Locale["DeleteAccount_Description"]</div>
                    </div>
                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="OpenDeleteAccount">@Locale["DeleteAccount_Button"]</MudButton>
                </div>
            </div>
        </SectionCard>
    }
</div>

@code {
    [Inject]
    private IProfileHttpClient HttpClient { get; set; } = null!;
    [Inject]
    private IProfileStore ProfileStore { get; set; } = null!;
    [Inject]
    private IDialogService DialogService { get; set; } = null!;
    [Inject]
    private IAuthStateChanged authStateChanged { get; set; } = null!;
    [Inject]
    private IStringLocalizer<AccountLocale> Locale { get; set; } = null!;
    [Inject]
    private IStringLocalizer<SharedLocale> SharedLocale { get; set; } = null!;
    [Inject]
    private ISnackbar Snackbar { get; set; } = null!;
    [Inject]
    private IStringLocalizer<BackendErrorCodeLocale> BackendLocale { get; set; } = null!;
    [Inject]
    private IClubProfileStore ClubProfileStore { get; set; } = null!;
    [Inject]
    private NavigationManager Navigation { get; set; } = null!;
    [Inject]
    private IJSRuntime JsRuntime { get; set; } = null!;

    private bool processing = false;
    private bool exporting;
    private string? profilePictureUrl;
    private bool isGuestSession;
    private string? pendingEmail;
    private ProfileInformationForm model = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        // The club profile may still be loading (e.g. when the page is opened directly), it decides whether "leave club" is shown
        ClubProfileStore.OnClubProfileChanged += OnClubProfileChanged;
        await FetchUserData();
    }

    public async void Cancel()
    {
        await FetchUserData();
        StateHasChanged();
    }

    public async void Submit(EditContext editContext)
    {
        processing = true;
        try
        {
            var result = await HttpClient.UpdateUserProfile(new UpdateUserProfileModel(model.FirstName, model.LastName, DateOnly.FromDateTime(model.Birthday!.Value), (Gender)model.Gender, (Language)model.Language, model.Street, model.City, model.ZipCode, (Country)model.Country));
            if (!result.Success)
            {
                Snackbar.ShowErrorDetails(result, BackendLocale);
                return;
            }

            Snackbar.Add(Locale["Profile_Saved"], Severity.Success);
            authStateChanged.AuthStateChanged();
            // Refresh the completion banner
            await ProfileStore.LoadProfileAsync();
        }
        finally
        {
            processing = false;
            StateHasChanged();
        }
    }

    private async Task OpenChangeEmail()
    {
        var parameters = new DialogParameters<ChangeEmailDialog> { { d => d.CurrentEmail, model.Email } };
        var dialog = await DialogService.ShowAsync<ChangeEmailDialog>(Locale["ChangeEmail"], parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string newEmail })
        {
            pendingEmail = newEmail;
            Snackbar.Add(string.Format(Locale["ChangeEmail_Sent"], newEmail), Severity.Success);
        }
    }

    private async Task OpenChangePassword()
    {
        var dialog = await DialogService.ShowAsync<ChangePasswordDialog>(Locale["ChangePassword"], new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
            Snackbar.Add(Locale["ChangePassword_Success"], Severity.Success);
    }

    private void OnClubProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => ClubProfileStore.OnClubProfileChanged -= OnClubProfileChanged;

    // Guest cards are handed out by the club, only a real club membership can be ended here
    private bool CanLeaveSelectedClub => ClubProfileStore.SelectedClub is not null && !ClubProfileStore.IsSupportMode && !ClubProfileStore.Roles.Contains(MemberRole.Guest);

    private async Task ExportData()
    {
        exporting = true;
        try
        {
            var result = await ProfileStore.ExportPersonalData();
            if (result is not { Success: true, Dto: not null })
            {
                Snackbar.ShowErrorDetails(result, BackendLocale);
                return;
            }

            using var streamReference = new DotNetStreamReference(new MemoryStream(result.Dto.Data));
            await JsRuntime.InvokeVoidAsync("App.downloadFileFromStream", result.Dto.FileName, streamReference);
        }
        finally
        {
            exporting = false;
        }
    }

    private async Task LeaveClub()
    {
        var clubName = ClubProfileStore.SelectedClub!.ClubName;
        var confirmed = await DialogService.ShowMessageBox(
            Locale["LeaveClub"],
            string.Format(Locale["LeaveClub_Confirm"], clubName),
            yesText: Locale["LeaveClub_Button"],
            cancelText: SharedLocale["Cancel"]);
        if (confirmed != true)
            return;

        var result = await ProfileStore.LeaveClub(ClubProfileStore.SelectedClubId);
        if (!result.Success)
        {
            Snackbar.ShowErrorDetails(result, BackendLocale);
            return;
        }

        Snackbar.Add(string.Format(Locale["LeaveClub_Success"], clubName), Severity.Success);
        // Reloads the profile and switches to another club (or asks to join one)
        authStateChanged.AuthStateChanged();
        Navigation.NavigateTo("/");
    }

    private async Task OpenDeleteAccount()
    {
        var dialog = await DialogService.ShowAsync<DeleteAccountDialog>(Locale["DeleteAccount"], new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result is not { Canceled: false })
            return;

        Snackbar.Add(Locale["DeleteAccount_Success"], Severity.Success);
        authStateChanged.AuthStateChanged();
        Navigation.NavigateToLogin();
    }

    private async Task OnProfilePictureSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        const long maxSize = 5 * 1024 * 1024;
        if (file.Size > maxSize)
        {
            Snackbar.Add(BackendLocale["FileTooLarge"], Severity.Error);
            return;
        }

        // Read file into memory and convert to a data URL for the crop dialog
        await using var readStream = file.OpenReadStream(maxSize);
        using var ms = new MemoryStream();
        await readStream.CopyToAsync(ms);
        var dataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";

        // Show crop dialog so the user can select the region
        var parameters = new DialogParameters<ProfilePictureCropDialog>();
        parameters.Add(d => d.ImageDataUrl, dataUrl);
        var dialog = await DialogService.ShowAsync<ProfilePictureCropDialog>(
            Locale["CropPhoto"], parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not string croppedDataUrl)
            return;

        // Convert the cropped data URL back to bytes and upload
        var base64 = croppedDataUrl[(croppedDataUrl.IndexOf(',') + 1)..];
        var imageBytes = Convert.FromBase64String(base64);
        await using var uploadStream = new MemoryStream(imageBytes);
        var uploadResult = await HttpClient.UploadProfilePicture(uploadStream, "profile.jpg", "image/jpeg");
        if (uploadResult.Success)
        {
            await ProfileStore.LoadProfileAsync();
            profilePictureUrl = ProfileStore.ProfilePictureUrl;
            StateHasChanged();
        }
        else
        {
            Snackbar.ShowErrorDetails(uploadResult, BackendLocale);
        }
    }

    private async Task FetchUserData()
    {
        var user = await HttpClient.GetUserProfile();
        if (user.Success && user.Dto is not null)
        {
            model = new()
            {
                Email = user.Dto.Email,
                FirstName = user.Dto.FirstName,
                LastName = user.Dto.LastName,
                Birthday = user.Dto.Birthday.ToDateTime(TimeOnly.MinValue),
                Gender = (int)user.Dto.Gender,
                Language = (int)user.Dto.Language,
                Street = user.Dto.Street,
                City = user.Dto.City,
                ZipCode = user.Dto.ZipCode,
                Country = (int)user.Dto.Country
            };
            profilePictureUrl = user.Dto.ProfilePictureUrl;
            isGuestSession = user.Dto.IsGuestSession;
        }
    }

    public class ProfileInformationForm
    {
        [Required(ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "EmailValidation"), EmailAddress(ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "EmailValidation")]
        public string Email { get; set; } = null!;

        [Required(ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "FirstnameValidation")]
        public string FirstName { get; set; } = null!;

        [Required(ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "LastnameValidation")]
        public string LastName { get; set; } = null!;

        [Required(ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "BirthdayValidation")]
        public DateTime? Birthday { get; set; }

        public int Gender { get; set; }

        public int Language { get; set; }

        public string? Street { get; set; }

        public string? City { get; set; }

        public string? ZipCode { get; set; }

        public int Country { get; set; }
    }
}
