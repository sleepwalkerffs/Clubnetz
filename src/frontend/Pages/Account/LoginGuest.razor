@page "/account/guestLogin"
@layout NotAuthorizedLayout

@using Bookennis.Client.Components.Shared
@using Bookennis.Client.Localization.Pages.Account
@using Bookennis.Client.Shared

@* Guest links (/account/guestLogin?guestCode=…) were replaced: the old links still lead here and explain what to do instead. *@

<PageTitle>@Locale["GuestLinkReplaced_Title"]</PageTitle>

<AuthShell Emoji="🎾" Title="@Locale["GuestLinkReplaced_Title"]" Subtitle="@Locale["GuestLinkReplaced_Subtitle"]" ShowFeatures="false">
    <ChildContent>
        <ol class="guest-info">
            <li>@Locale["GuestLinkReplaced_Step1"]</li>
            <li>@Locale["GuestLinkReplaced_Step2"]</li>
            <li>@Locale["GuestLinkReplaced_Step3"]</li>
        </ol>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">@Locale["GuestLinkReplaced_Credits"]</MudAlert>
        <div class="d-flex flex-column gap-2">
            <MudButton Href="account/forgot-password" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large">
                @Locale["GuestLinkReplaced_SetPassword"]
            </MudButton>
            <MudButton Href="account/login" Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true">
                @Locale["Login"]
            </MudButton>
        </div>
    </ChildContent>
</AuthShell>

@code {
    [Inject]
    private IStringLocalizer<AccountLocale> Locale { get; set; } = null!;
}
