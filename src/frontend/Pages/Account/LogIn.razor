@page "/account/login";
@layout NotAuthorizedLayout

@using System.ComponentModel.DataAnnotations
@using Bookennis.Client.Components.Shared
@using Bookennis.Client.Localization
@using Bookennis.Client.Localization.Pages.Account
@using Bookennis.Client.Services
@using Bookennis.Client.Services.HttpClients.Account
@using Bookennis.Client.Shared
@using Bookennis.Client.Utils
@using Bookennis.Shared.Controller.Account
@using Bookennis.Client.Components.Shared.Buttons

<PageTitle>@Locale["Login"]</PageTitle>

<AuthShell Title="@Locale["Login_Title"]" Subtitle="@Locale["Login_Subtitle"]">
    <ChildContent>
        <EditForm Model="@model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <div class="d-flex gap-3 flex-column">
                <MudTextField Variant="Variant.Outlined" T="string" Label=@Locale["Email"] InputType="InputType.Email"
                              @bind-Value="model.Email" For="@(() => model.Email)"
                              UserAttributes="@(new() { ["autocomplete"] = "email" })" />
                <PasswordField TType="string" @bind-Value="model.Password" For="@(() => model.Password)" Label=@Locale["Password"] AutoComplete="current-password" />
                <div class="d-flex flex-wrap align-center justify-space-between gap-2">
                    <MudCheckBox Label=@Locale["RememberMe"] @bind-Value="model.RememberMe" For="@(() => model.RememberMe)" Color="Color.Primary" Dense="true" />
                    <MudLink Href="@ForgotPasswordHref" Typo="Typo.body2" Underline="Underline.Hover" Color="Color.Primary">
                        @Locale["ForgotPasswordLink"]
                    </MudLink>
                </div>
            </div>
            <LoadButton ButtonType="ButtonType.Submit"
                        FullWidth="true"
                        Size="Size.Large"
                        Variant="Variant.Filled"
                        Color="Color.Primary"
                        Loading="@processing"
                        Disabled="@processing"
                        Class="mt-6">
                @Locale["Login"]
            </LoadButton>
        </EditForm>
    </ChildContent>
    <Footer>
        <span>@Locale["Login_NoAccount"]</span>
        <MudButton Href="account/register"
                   Variant="Variant.Outlined"
                   Color="Color.Primary"
                   FullWidth="true"
                   StartIcon="@Icons.Material.Filled.PersonAddAlt">
            @Locale["CreateFreeAccount"]
        </MudButton>
    </Footer>
</AuthShell>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [Inject]
    private IAccountHttpClient AccountHttpClient { get; set; } = null!;
    [Inject]
    private NavigationManager navigation { get; set; } = null!;
    [Inject]
    private ISnackbar snackbar { get; set; } = null!;
    [Inject]
    private IAuthStateChanged authState { get; set; } = null!;
    [Inject]
    private IStringLocalizer<AccountLocale> Locale { get; set; } = null!;
    [Inject]
    private IStringLocalizer<BackendErrorCodeLocale> BackendLocale { get; set; } = null!;

    private LoginUserForm model = new();

    private bool processing = false;

    // Hand the typed email over so the user doesn't have to type it again
    private string ForgotPasswordHref => string.IsNullOrWhiteSpace(model.Email)
        ? "account/forgot-password"
        : $"account/forgot-password?email={Uri.EscapeDataString(model.Email.Trim())}";

    public async Task Submit()
    {
        processing = true;
        try
        {
            var result = await AccountHttpClient.LoginUser(new LoginUserModel(model.Email!, model.Password!, model.RememberMe));

            if (!result.Success)
            {
                snackbar.ShowErrorDetails(result, BackendLocale);
            }
            else if (result.Success)
            {
                navigation.NavigateTo(Services.NavigationManagerExtensions.IsLocalReturnUrl(ReturnUrl) ? ReturnUrl! : "/");
                authState.AuthStateChanged();
            }
        }
        finally
        {
            processing = false;
            StateHasChanged();
        }
    }

    public class LoginUserForm
    {
        [Required(ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "EmailValidation"),
         EmailAddress(ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "EmailValidation")]
        public string? Email { get; set; }

        [Required(ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "PasswordValidation"),
         StringLength(50, MinimumLength = 8, ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "PasswordLength")]
        public string? Password { get; set; }

        public bool RememberMe { get; set; } = false;
    }
}
