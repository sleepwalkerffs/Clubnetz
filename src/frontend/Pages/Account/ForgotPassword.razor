@page "/account/forgot-password"
@layout NotAuthorizedLayout

@using Bookennis.Client.Components.Shared
@using Bookennis.Client.Localization
@using Bookennis.Client.Localization.Pages.Account
@using Bookennis.Client.Services
@using Bookennis.Client.Services.HttpClients.Account
@using Bookennis.Client.Shared
@using System.ComponentModel.DataAnnotations
@using Bookennis.Client.Utils
@using Bookennis.Shared.Controller.Account
@using Bookennis.Client.Components.Shared.Buttons

@implements IDisposable

<PageTitle>@Locale["ForgotPassword"]</PageTitle>

@if (sentTo is null)
{
    <AuthShell Emoji="🔑" Title="@Locale["ForgotPassword_Title"]" Subtitle="@Locale["ForgotPassword_Subtitle"]" ShowFeatures="false">
        <ChildContent>
            <EditForm Model="@model" OnValidSubmit="Submit">
                <DataAnnotationsValidator />
                <MudTextField Variant="Variant.Outlined" T="string" Label=@Locale["Email"] InputType="InputType.Email"
                              @bind-Value="model.Email" For="@(() => model.Email)"
                              UserAttributes="@(new() { ["autocomplete"] = "email" })" />
                <LoadButton ButtonType="ButtonType.Submit"
                            FullWidth="true"
                            Size="Size.Large"
                            Variant="Variant.Filled"
                            Color="Color.Primary"
                            Loading="@processing"
                            Disabled="@processing"
                            Class="mt-6">
                    @Locale["SendResetEmail"]
                </LoadButton>
            </EditForm>
        </ChildContent>
        <Footer>
            <MudLink Href="account/login" Underline="Underline.Hover" Color="Color.Primary">@Locale["BackToLogin"]</MudLink>
        </Footer>
    </AuthShell>
}
else
{
    <AuthShell Emoji="📬" Title="@Locale["CheckInbox_Title"]" Subtitle="@string.Format(Locale["ForgotPassword_CheckInbox"], sentTo)" ShowFeatures="false">
        <ChildContent>
            <ol class="reset-steps">
                <li>@Locale["ForgotPassword_Step1"]</li>
                <li>@Locale["ForgotPassword_Step2"]</li>
                <li>@Locale["ForgotPassword_Step3"]</li>
            </ol>
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mt-4">@Locale["CheckInbox_Spam"]</MudAlert>
            <LoadButton FullWidth="true"
                        Variant="Variant.Outlined"
                        Color="Color.Primary"
                        Loading="@processing"
                        Disabled="@(processing || resendCooldown > 0)"
                        OnClick="Resend"
                        Class="mt-6">
                @(resendCooldown > 0 ? string.Format(Locale["ResendIn"], resendCooldown) : Locale["Resend"])
            </LoadButton>
        </ChildContent>
        <Footer>
            <MudLink OnClick="UseDifferentEmail" Underline="Underline.Hover" Color="Color.Default" Typo="Typo.body2">@Locale["UseDifferentEmail"]</MudLink>
            <MudLink Href="account/login" Underline="Underline.Hover" Color="Color.Primary">@Locale["BackToLogin"]</MudLink>
        </Footer>
    </AuthShell>
}

@code {
    private const int ResendCooldownSeconds = 30;

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [Inject]
    private IAccountHttpClient AccountHttpClient { get; set; } = null!;
    [Inject]
    private ISnackbar Snackbar { get; set; } = null!;
    [Inject]
    private IStringLocalizer<AccountLocale> Locale { get; set; } = null!;
    [Inject]
    private IStringLocalizer<BackendErrorCodeLocale> BackendLocale { get; set; } = null!;

    private ResetPasswordForm model = new();
    private bool processing = false;
    private string? sentTo;
    private int resendCooldown;
    private System.Threading.Timer? cooldownTimer;

    protected override void OnInitialized()
    {
        model.Email = Email;
    }

    public async Task Submit()
    {
        if (await SendResetEmail(model.Email!.Trim()))
            sentTo = model.Email.Trim();
    }

    private async Task Resend()
    {
        if (sentTo is not null && await SendResetEmail(sentTo))
            Snackbar.Add(Locale["ResendSuccess"], Severity.Success);
    }

    private void UseDifferentEmail()
    {
        StopCooldown();
        sentTo = null;
    }

    private async Task<bool> SendResetEmail(string email)
    {
        processing = true;
        try
        {
            var response = await AccountHttpClient.ForgotPassword(new ForgotPasswordModel(email));
            if (!response.Success)
            {
                Snackbar.ShowErrorDetails(response, BackendLocale);
                return false;
            }

            StartCooldown();
            return true;
        }
        finally
        {
            processing = false;
            StateHasChanged();
        }
    }

    private void StartCooldown()
    {
        StopCooldown();
        resendCooldown = ResendCooldownSeconds;
        cooldownTimer = new System.Threading.Timer(_ =>
        {
            resendCooldown--;
            if (resendCooldown <= 0)
                StopCooldown();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopCooldown()
    {
        cooldownTimer?.Dispose();
        cooldownTimer = null;
        resendCooldown = 0;
    }

    public void Dispose() => cooldownTimer?.Dispose();

    public class ResetPasswordForm
    {
        [Required(ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "EmailValidation"), EmailAddress(ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "EmailValidation")]
        public string? Email { get; set; }
    }
}
