@page "/account/reset-password";
@layout NotAuthorizedLayout

@using Bookennis.Client.Components.Shared
@using Bookennis.Client.Localization
@using Bookennis.Client.Localization.Pages.Account
@using Bookennis.Client.Services
@using Bookennis.Client.Services.HttpClients.Account
@using Bookennis.Client.Shared
@using System.ComponentModel.DataAnnotations
@using Bookennis.Client.Utils
@using Bookennis.Shared.Controller.Account
@using Bookennis.Client.Components.Shared.Buttons

@implements IDisposable

<PageTitle>@Locale["ResetPassword"]</PageTitle>

@if (!ValidParameters)
{
    <AuthShell Emoji="⚠️" Title="@Locale["ResetPassword_InvalidTitle"]" Subtitle="@Locale["ResetPassword_InvalidText"]" ShowFeatures="false">
        <ChildContent>
            <MudButton Href="account/forgot-password" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large">
                @Locale["RequestNewLink"]
            </MudButton>
        </ChildContent>
        <Footer>
            <MudLink Href="account/login" Underline="Underline.Hover" Color="Color.Primary">@Locale["BackToLogin"]</MudLink>
        </Footer>
    </AuthShell>
}
else if (success)
{
    <AuthShell Emoji="✅" Title="@Locale["ResetPassword_SuccessTitle"]" Subtitle="@Locale["ResetPassword_SuccessText"]" ShowFeatures="false">
        <MudButton Href="account/login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large">
            @Locale["GoToLogin"]
        </MudButton>
    </AuthShell>
}
else
{
    <AuthShell Emoji="🔒" Title="@Locale["ResetPassword_Title"]" Subtitle="@string.Format(Locale["ResetPassword_Subtitle"], Email)" ShowFeatures="false">
        <ChildContent>
            <EditForm EditContext="@context" OnValidSubmit="ConfirmResetPasswordAction">
                <DataAnnotationsValidator />
                <div class="d-flex gap-3 flex-column">
                    <PasswordField TType="string"
                                   Label=@Locale["NewPassword"]
                                   Immediate="true"
                                   AutoComplete="new-password"
                                   @bind-Value="model.Password"
                                   For="@(() => model.Password)" />
                    <PasswordRequirements Password="@model.Password" />
                    <PasswordField TType="string"
                                   Label=@Locale["RepeatNewPassword"]
                                   AutoComplete="new-password"
                                   @bind-Value="model.Password2"
                                   For="@(() => model.Password2)" />
                </div>
                <LoadButton ButtonType="ButtonType.Submit"
                            FullWidth="true"
                            Size="Size.Large"
                            Variant="Variant.Filled"
                            Color="Color.Primary"
                            Loading="@processing"
                            Disabled="@processing"
                            Class="mt-6">
                    @Locale["SaveNewPassword"]
                </LoadButton>
            </EditForm>
        </ChildContent>
        <Footer>
            <MudLink Href="account/login" Underline="Underline.Hover" Color="Color.Primary">@Locale["BackToLogin"]</MudLink>
        </Footer>
    </AuthShell>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Email { get; set; }
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    [Inject]
    private IAccountHttpClient AccountHttpClient { get; set; } = null!;
    [Inject]
    private ISnackbar Snackbar { get; set; } = null!;
    [Inject]
    private IStringLocalizer<AccountLocale> Locale { get; set; } = null!;
    [Inject]
    private IStringLocalizer<BackendErrorCodeLocale> BackendLocale { get; set; } = null!;

    private bool ValidParameters => !string.IsNullOrWhiteSpace(Email) && !string.IsNullOrWhiteSpace(Token);
    private EditContext context = null!;
    private ResetPasswordForm model = new();
    private ValidationMessageStore messageStore = null!;
    private bool processing = false;
    private bool success = false;

    protected override void OnInitialized()
    {
        context = new EditContext(model);
        context.OnValidationRequested += HandleValidationRequested;
        messageStore = new ValidationMessageStore(context);
    }

    private async Task ConfirmResetPasswordAction()
    {
        processing = true;
        try
        {
            var response = await AccountHttpClient.ResetPassword(new ResetPasswordModel(Email!, Token!, model.Password ?? string.Empty));
            if (!response.Success)
            {
                Snackbar.ShowErrorDetails(response, BackendLocale);
                return;
            }

            success = true;
        }
        finally
        {
            processing = false;
            StateHasChanged();
        }
    }

    private void HandleValidationRequested(object? sender, ValidationRequestedEventArgs args)
    {
        messageStore.Clear();
        if (model.Password == null)
            return;

        foreach (var error in PasswordValidation.ValidatePassword(model.Password, Locale))
        {
            messageStore.Add(() => model.Password, error);
        }
    }

    private class ResetPasswordForm
    {
        [Required(ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "PasswordValidation"),
         StringLength(PasswordValidation.MaxLength, MinimumLength = PasswordValidation.MinLength, ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "PasswordLength")]
        public string? Password { get; set; }

        [Required(ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "PasswordValidation")]
        [Compare(nameof(Password), ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "Password2Validation")]
        public string? Password2 { get; set; }
    }

    public void Dispose()
    {
        context.OnValidationRequested -= HandleValidationRequested;
    }
}
