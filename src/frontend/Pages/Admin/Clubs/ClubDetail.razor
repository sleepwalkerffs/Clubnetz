@page "/admin/clubs/{ClubId:int}"
@using System.Globalization
@using Bookennis.Client.Components.Shared
@using Bookennis.Client.Localization.Navigation
@using Bookennis.Client.Services
@using Bookennis.Client.Services.Store.Admin
@using Bookennis.Shared.Controller.Admin
@using Bookennis.Shared.Controller.Shared

@implements IDisposable

<PageTitle>@L["AdminPanel"] - @Club?.Name</PageTitle>

@if (Club is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    var club = Club;
    var hasActiveSeason = club.Seasons.Any(s => s.IsActive);

    <div class="admin-page">
        <AdminHero Emoji="🎾" Eyebrow="@L["ClubEyebrow"]" Title="@club.Name"
                   Subtitle="@string.Format(L["ClubSince"], club.CreatedAt.ToLocalTime().ToString("d", CultureInfo.CurrentCulture))">
            <Chips>
                <span class="hero-chip">👥 @string.Format(L["MembersCount"], club.MemberCount)</span>
                <span class="hero-chip">🎟️ @string.Format(L["GuestsCount"], club.GuestCount)</span>
                <span class="hero-chip">🏟️ @string.Format(L["CourtsCount"], club.CourtCount)</span>
                <span class="hero-chip">📅 @string.Format(L["BookingsCount"], club.BookingsLast30Days)</span>
                @if (!hasActiveSeason)
                {
                    <span class="hero-chip hero-chip--warn">⛔ @L["NoActiveSeason"]</span>
                }
            </Chips>
            <Aside>
                <div class="admin-hero-aside__caption">@L["SupportCardTitle"]</div>
                <div class="admin-hero-aside__text">@L["ClubsCardSubtitle"]</div>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Login" Class="admin-hero-button"
                           OnClick="@(() => NavigationManager.OpenClubAsAdministrator(ClubId))">
                    @L["OpenClub"]
                </MudButton>
            </Aside>
        </AdminHero>

        <SectionCard Emoji="🛟" Title="@L["SupportCardTitle"]">
            <div class="admin-text">@L["SupportCardText"]</div>
            <div class="admin-quicklinks">
                @foreach (var link in QuickLinks)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@link.Icon" OnClick="@(() => OpenInClub(link.Path))">
                        @link.Title
                    </MudButton>
                }
            </div>
        </SectionCard>

        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <SectionCard Emoji="🧑‍💼" Title="@L["ClubAdminsTitle"]" Subtitle="@L["ClubAdminsSubtitle"]">
                    @if (club.Admins.Count == 0)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Text">@L["NoAdminsHint"]</MudAlert>
                    }
                    else
                    {
                        <div class="admin-list">
                            @foreach (var admin in club.Admins)
                            {
                                <a class="admin-row" href="@($"/admin/users/{admin.UserId}")">
                                    <UserAvatar FirstName="@admin.FullName" LastName="" Color="Color.Primary" />
                                    <div class="admin-row__main">
                                        <div class="admin-row__title">@admin.FullName</div>
                                        <div class="admin-row__text">@admin.Email</div>
                                    </div>
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                                </a>
                            }
                        </div>
                    }
                </SectionCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <SectionCard Emoji="➕" Title="@L["AddPersonTitle"]" Subtitle="@L["AddPersonSubtitle"]">
                    <MudAutocomplete T="AdminUserResult" Label="@L["SearchUserByEmail"]" @bind-Value="selectedUser"
                                     SearchFunc="SearchUsers" MinCharacters="2" DebounceInterval="300"
                                     ToStringFunc="@(u => u is null ? string.Empty : $"{u.FullName} ({u.Email})")"
                                     ResetValueOnEmptyText="true" Variant="Variant.Outlined">
                        <ItemTemplate Context="user">
                            <MudText>@user.FullName</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@user.Email</MudText>
                        </ItemTemplate>
                    </MudAutocomplete>
                    <MudCheckBox @bind-Value="addAsAdmin" Label="@L["AddAsAdmin"]" Color="Color.Primary" Class="mt-2" />
                    <div class="admin-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddMember" StartIcon="@Icons.Material.Filled.PersonAdd" Disabled="@(selectedUser is null)">
                            @L["AddMember"]
                        </MudButton>
                    </div>
                </SectionCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <SectionCard Emoji="⚙️" Title="@L["PlatformSettingsTitle"]" Subtitle="@L["PlatformSettingsSubtitle"]">
                    <MudTextField @bind-Value="clubName" Label="@L["ClubName"]" Required="true" Variant="Variant.Outlined" />
                    <MudCheckBox @bind-Value="isAtpClub" Label="@L["IsAtpClub"]" Color="Color.Primary" Class="mt-2" />
                    <div class="admin-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveClub" StartIcon="@Icons.Material.Filled.Save">@L["SaveSettings"]</MudButton>
                    </div>
                </SectionCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <SectionCard Emoji="⚠️" Title="@L["DangerZone"]" Class="admin-danger">
                    <div class="admin-text">@L["DeleteClubHint"]</div>
                    <div class="admin-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="DeleteClub" StartIcon="@Icons.Material.Filled.DeleteForever">@L["DeleteClub"]</MudButton>
                    </div>
                </SectionCard>
            </MudItem>
        </MudGrid>
    </div>
}

@code {
    [Parameter] public int ClubId { get; set; }

    [Inject] private IAdminStore AdminStore { get; set; } = null!;
    [Inject] private NavigationManager NavigationManager { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = null!;
    [Inject] private IStringLocalizer<AdminLocale> L { get; set; } = null!;
    [Inject] private IStringLocalizer<NavigationLocale> NavigationLocale { get; set; } = null!;
    [Inject] private IStringLocalizer<SharedLocale> SharedLocale { get; set; } = null!;

    private string clubName = "";
    private bool isAtpClub;
    private AdminUserResult? selectedUser;
    private bool addAsAdmin;

    // The store keeps the club that was opened last
    private AdminClubDetailResult? Club => AdminStore.ClubDetail?.Id == ClubId ? AdminStore.ClubDetail : null;

    /// <summary>Pages of the club that are opened in support mode.</summary>
    private (string Title, string Icon, string Path)[] QuickLinks =>
    [
        (NavigationLocale["ClubSettings"], Icons.Material.Filled.Handyman, "profile"),
        (NavigationLocale["Members"], Icons.Material.Filled.Groups2, "members"),
        (SharedLocale["Guests"], Icons.Material.Filled.Person, "guests"),
        (NavigationLocale["CourtBlockings"], Icons.Material.Filled.Lock, "court-blockings"),
        (NavigationLocale["News"], Icons.Material.Filled.Campaign, "news"),
        (NavigationLocale["Calendar"], Icons.Material.Filled.CalendarMonth, "calendar"),
        (SharedLocale["BadgeSettings"], Icons.Material.Filled.EmojiEvents, "badge-settings"),
        (NavigationLocale["EmailTemplates"], Icons.Material.Filled.MarkEmailRead, "email-templates"),
        (NavigationLocale["ClubStatistics"], Icons.Material.Filled.Analytics, "club-statistics"),
    ];

    protected override async Task OnInitializedAsync()
    {
        AdminStore.OnClubDetailChanged += OnClubDetailChanged;
        await AdminStore.LoadClub(ClubId);
    }

    private void OnClubDetailChanged()
    {
        if (Club is { } club)
        {
            clubName = club.Name;
            isAtpClub = club.IsAtpClub;
        }

        InvokeAsync(StateHasChanged);
    }

    // A full page load, the stores still hold the data of the club that was open before
    private void OpenInClub(string path) => NavigationManager.NavigateTo($"/clubs/{ClubId}/{path}", forceLoad: true);

    private async Task SaveClub()
    {
        if (Club is not { } club)
            return;

        if (string.IsNullOrWhiteSpace(clubName))
        {
            Snackbar.Add(L["FillRequiredFields"], Severity.Warning);
            return;
        }

        // Everything else is managed in the club itself and sent back unchanged
        var success = await AdminStore.UpdateClub(ClubId, new UpdateAdminClubRequest
        {
            Name = clubName.Trim(),
            OpeningHours = club.OpeningHours,
            PrimeTimeSettings = club.PrimeTimeSettings,
            BookingGracePeriodInMinutes = club.BookingGracePeriodInMinutes,
            IsAtpClub = isAtpClub
        });

        if (success)
        {
            Snackbar.Add(L["ClubUpdated"], Severity.Success);
            await AdminStore.LoadClub(ClubId);
        }
        else
        {
            Snackbar.Add(L["FailedUpdateClub"], Severity.Error);
        }
    }

    private async Task<IEnumerable<AdminUserResult>> SearchUsers(string searchTerm, CancellationToken cancellationToken)
        => string.IsNullOrWhiteSpace(searchTerm) ? [] : await AdminStore.SearchUsers(searchTerm);

    private async Task AddMember()
    {
        if (selectedUser is null)
        {
            Snackbar.Add(L["SelectUser"], Severity.Warning);
            return;
        }

        var success = await AdminStore.AddClubMember(ClubId, new AddClubMemberRequest
        {
            UserId = selectedUser.Id,
            Roles = addAsAdmin ? [MemberRole.User, MemberRole.Admin] : [MemberRole.User]
        });

        if (success)
        {
            Snackbar.Add(L["MemberAdded"], Severity.Success);
            selectedUser = null;
            addAsAdmin = false;
            await AdminStore.LoadClub(ClubId);
        }
        else
        {
            Snackbar.Add(L["FailedAddMember"], Severity.Error);
        }
    }

    private async Task DeleteClub()
    {
        var result = await DialogService.ShowMessageBox(
            L["ConfirmDeletion"],
            string.Format(L["DeleteClubConfirm"], Club?.Name),
            yesText: SharedLocale["Delete"], cancelText: SharedLocale["Cancel"]);

        if (result != true)
            return;

        if (await AdminStore.DeleteClub(ClubId))
        {
            Snackbar.Add(L["ClubDeleted"], Severity.Success);
            NavigationManager.NavigateTo("/admin/clubs");
        }
        else
        {
            Snackbar.Add(L["FailedDeleteClub"], Severity.Error);
        }
    }

    public void Dispose() => AdminStore.OnClubDetailChanged -= OnClubDetailChanged;
}
