@page "/admin/users"
@using Bookennis.Client.Components.Shared
@using Bookennis.Client.Services.Store.Admin
@using Bookennis.Shared.Utils.Paging

@implements IDisposable

<PageTitle>@L["AdminPanel"] - @L["Users"]</PageTitle>

<div class="admin-page">
    <AdminHero Emoji="👤" Eyebrow="@L["PlatformAdministration"]" Title="@L["Users"]" Subtitle="@L["UsersSubtitle"]" />

    <div class="admin-toolbar">
        <MudTextField T="string" @bind-Value="searchString" DebounceInterval="300" OnDebounceIntervalElapsed="OnSearchChanged" Clearable="true"
                      OnClearButtonClick="OnSearchCleared" Placeholder="@L["SearchUsers"]" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Class="admin-toolbar__search" />
        @if (AdminStore.UsersLoaded)
        {
            <div class="admin-toolbar__count">@string.Format(L["UsersChip"], AdminStore.TotalUsers)</div>
        }
    </div>

    <div class="admin-list-card">
        @if (AdminStore.IsLoading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }

        @if (AdminStore.UsersLoaded && AdminStore.Users.Count == 0)
        {
            <div class="admin-empty">
                <div class="admin-empty__emoji" aria-hidden="true">🔍</div>
                <div>@L["NoUsersFound"]</div>
            </div>
        }
        else
        {
            <div class="admin-list">
                @foreach (var user in AdminStore.Users)
                {
                    <a class="admin-row" href="@($"/admin/users/{user.Id}")" @key="user.Id">
                        <UserAvatar FirstName="@user.FirstName" LastName="@user.LastName" Color="Color.Primary" />
                        <div class="admin-row__main">
                            <div class="admin-row__title">@user.LastName @user.FirstName</div>
                            <div class="admin-row__text">@user.Email</div>
                        </div>
                        <div class="admin-row__aside">
                            @if (!user.EmailConfirmed)
                            {
                                <span class="admin-chip admin-chip--warn">✉️ @L["Unconfirmed"]</span>
                            }
                            <span class="admin-chip">🎂 @user.Birthday.ToString("d")</span>
                        </div>
                    </a>
                }
            </div>
        }
    </div>

    @if (PageCount > 1)
    {
        <div class="d-flex justify-center">
            <MudPagination Count="@PageCount" Selected="@currentPage" SelectedChanged="OnPageChanged" Color="Color.Primary" Variant="Variant.Text" />
        </div>
    }
</div>

@code {
    private const int PageSize = 25;

    [Inject] private IAdminStore AdminStore { get; set; } = null!;
    [Inject] private IStringLocalizer<AdminLocale> L { get; set; } = null!;

    private string? searchString;
    private int currentPage = 1;

    private int PageCount => (int)Math.Ceiling((double)AdminStore.TotalUsers / PageSize);

    protected override async Task OnInitializedAsync()
    {
        AdminStore.OnUsersChanged += OnChanged;
        await LoadUsers();
    }

    private Task LoadUsers()
        => AdminStore.LoadUsers(new PaginationParameters { Page = currentPage, PageSize = PageSize, EnablePaging = true }, null, string.IsNullOrWhiteSpace(searchString) ? null : searchString.Trim());

    private Task OnSearchChanged(string _)
    {
        currentPage = 1;
        return LoadUsers();
    }

    private Task OnSearchCleared()
    {
        searchString = null;
        currentPage = 1;
        return LoadUsers();
    }

    private Task OnPageChanged(int selectedPage)
    {
        currentPage = selectedPage;
        return LoadUsers();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => AdminStore.OnUsersChanged -= OnChanged;
}
