@page "/admin/users/{UserId:int}"
@using System.Globalization
@using Bookennis.Client.Components.Shared
@using Bookennis.Client.Services
@using Bookennis.Client.Services.Store.Admin
@using Bookennis.Shared.Controller.Admin
@using Bookennis.Shared.Controller.Shared

@implements IDisposable

<PageTitle>@L["AdminPanel"] - @User?.FullName</PageTitle>

@if (User is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    var user = User;

    <div class="admin-page">
        <AdminHero Eyebrow="@L["UserEyebrow"]" Title="@user.FullName" Subtitle="@user.Email">
            <Media>
                <UserAvatar FirstName="@user.FirstName" LastName="@user.LastName" Size="Size.Large" />
            </Media>
            <Chips>
                @if (user.EmailConfirmed)
                {
                    <span class="hero-chip hero-chip--ok">✅ @L["EmailConfirmed"]</span>
                }
                else
                {
                    <span class="hero-chip hero-chip--warn">✉️ @L["Unconfirmed"]</span>
                }
                <span class="hero-chip">🗓️ @string.Format(L["RegisteredOn"], user.RegisteredAt.ToLocalTime().ToString("d", CultureInfo.CurrentCulture))</span>            </Chips>
        </AdminHero>

        <SectionCard Emoji="🎾" Title="@L["Clubs"]" Subtitle="@L["ClubsOfUserSubtitle"]">
            @if (user.Clubs.Count == 0)
            {
                <div class="admin-text">@L["NoClubs"]</div>
            }
            else
            {
                <div class="admin-list">
                    @foreach (var club in user.Clubs)
                    {
                        <div class="admin-row" @key="club.MemberId">
                            <div class="admin-row__main">
                                <a class="admin-row__title" href="@($"/admin/clubs/{club.ClubId}")">@club.ClubName</a>
                                <div class="admin-chips mt-1">
                                    @if (club.IsGuest)
                                    {
                                        <span class="admin-chip admin-chip--info">🎟️ @L["Guest"]</span>
                                    }
                                    else
                                    {
                                        @foreach (var role in club.Roles)
                                        {
                                            <span class="@($"admin-chip {(role == MemberRole.Admin ? "admin-chip--ok" : null)}")">@SharedLocale[$"Role_{role}"]</span>
                                        }
                                    }
                                </div>
                            </div>
                            <div class="admin-row__aside">
                                @if (!club.IsGuest)
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Person"
                                               OnClick="@(() => NavigationManager.NavigateTo($"/clubs/{club.ClubId}/members/{club.MemberId}", forceLoad: true))">
                                        @L["OpenMember"]
                                    </MudButton>
                                }
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Login"
                                           OnClick="@(() => NavigationManager.OpenClubAsAdministrator(club.ClubId))">
                                    @L["OpenClub"]
                                </MudButton>
                            </div>
                        </div>
                    }
                </div>
            }
        </SectionCard>

        <MudGrid Spacing="3">
            <MudItem xs="12" lg="7">
                <SectionCard Emoji="🪪" Title="@L["PersonalData"]" Subtitle="@L["PersonalDataSubtitle"]">
                    <div class="admin-fields">
                        <MudTextField @bind-Value="firstName" Label="@SharedLocale["Firstname"]" Required="true" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="lastName" Label="@SharedLocale["Lastname"]" Required="true" Variant="Variant.Outlined" />
                        <MudDatePicker @bind-Date="birthday" Label="@SharedLocale["Birthday"]" Variant="Variant.Outlined" PickerVariant="PickerVariant.Dialog" DateFormat="dd.MM.yyyy" />
                        <MudSelect T="Gender" @bind-Value="gender" Label="@SharedLocale["Gender"]" Variant="Variant.Outlined">
                            <MudSelectItem T="Gender" Value="Gender.Male">@SharedLocale["Mr"]</MudSelectItem>
                            <MudSelectItem T="Gender" Value="Gender.Female">@SharedLocale["Mrs"]</MudSelectItem>
                            <MudSelectItem T="Gender" Value="Gender.Diverse">@SharedLocale["None"]</MudSelectItem>
                        </MudSelect>
                        <div class="admin-fields__full">
                            <MudTextField @bind-Value="street" Label="@SharedLocale["Street"]" Variant="Variant.Outlined" />
                        </div>
                        <MudTextField @bind-Value="zipCode" Label="@SharedLocale["ZipCode"]" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="city" Label="@SharedLocale["City"]" Variant="Variant.Outlined" />
                        <div class="admin-fields__full">
                            <MudSelect T="Country" @bind-Value="country" Label="@SharedLocale["Country"]" Variant="Variant.Outlined">
                                <MudSelectItem T="Country" Value="Country.Austria">@SharedLocale["Austria"]</MudSelectItem>
                                <MudSelectItem T="Country" Value="Country.Germany">@SharedLocale["Germany"]</MudSelectItem>
                                <MudSelectItem T="Country" Value="Country.Switzerland">@SharedLocale["Switzerland"]</MudSelectItem>
                            </MudSelect>
                        </div>
                    </div>
                    <div class="admin-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveUser" StartIcon="@Icons.Material.Filled.Save">@L["SaveChanges"]</MudButton>
                    </div>
                </SectionCard>
            </MudItem>

            <MudItem xs="12" lg="5">
                <div class="d-flex flex-column gap-4">
                    <SectionCard Emoji="✉️" Title="@L["EmailManagement"]" Subtitle="@L["EmailSubtitle"]">
                        <div class="admin-chips mb-3">
                            <span class="admin-chip">@user.Email</span>
                            @if (user.EmailConfirmed)
                            {
                                <span class="admin-chip admin-chip--ok">✅ @L["EmailConfirmed"]</span>
                            }
                            else
                            {
                                <span class="admin-chip admin-chip--warn">@L["Unconfirmed"]</span>
                            }
                        </div>
                        <MudTextField @bind-Value="newEmail" Label="@L["NewEmail"]" InputType="InputType.Email" Variant="Variant.Outlined" HelperText="@L["ChangeEmailHint"]" />
                        <div class="admin-actions">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ChangeEmail" StartIcon="@Icons.Material.Filled.AlternateEmail">@L["ChangeEmail"]</MudButton>
                            @if (!user.EmailConfirmed)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="ResendConfirmation" StartIcon="@Icons.Material.Filled.Email">@L["ResendConfirmationEmail"]</MudButton>
                            }
                        </div>
                    </SectionCard>

                    <SectionCard Emoji="🔑" Title="@L["Password"]">
                        <div class="admin-text">@L["PasswordHint"]</div>
                        <div class="admin-actions">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ResetPassword" StartIcon="@Icons.Material.Filled.LockReset">@L["SendPasswordResetLink"]</MudButton>
                        </div>
                    </SectionCard>

                    <SectionCard Emoji="🎭" Title="@L["Impersonation"]">
                        <div class="admin-text">@L["ImpersonateDescription"]</div>
                        <div class="admin-actions">
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="ImpersonateUser" StartIcon="@Icons.Material.Filled.SwitchAccount">@L["Impersonate"]</MudButton>
                        </div>
                    </SectionCard>

                    <SectionCard Emoji="⚠️" Title="@L["DangerZone"]" Class="admin-danger">
                        <div class="admin-text">@L["DeleteUserHint"]</div>
                        <div class="admin-actions">
                            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="DeleteUser" StartIcon="@Icons.Material.Filled.DeleteForever">@L["DeleteUser"]</MudButton>
                        </div>
                    </SectionCard>
                </div>
            </MudItem>
        </MudGrid>
    </div>
}

@code {
    [Parameter] public int UserId { get; set; }

    [Inject] private IAdminStore AdminStore { get; set; } = null!;
    [Inject] private NavigationManager NavigationManager { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = null!;
    [Inject] private IStringLocalizer<AdminLocale> L { get; set; } = null!;
    [Inject] private IStringLocalizer<SharedLocale> SharedLocale { get; set; } = null!;

    private string firstName = "";
    private string lastName = "";
    private DateTime? birthday;
    private Gender gender;
    private string? street;
    private string? city;
    private string? zipCode;
    private Country country;
    private string newEmail = "";

    // The store keeps the user that was opened last
    private AdminUserDetailResult? User => AdminStore.UserDetail?.Id == UserId ? AdminStore.UserDetail : null;

    protected override async Task OnInitializedAsync()
    {
        AdminStore.OnUserDetailChanged += OnUserDetailChanged;
        await AdminStore.LoadUser(UserId);
    }

    private void OnUserDetailChanged()
    {
        if (User is { } user)
        {
            firstName = user.FirstName;
            lastName = user.LastName;
            birthday = user.Birthday.ToDateTime(TimeOnly.MinValue);
            gender = user.Gender;
            street = user.Street;
            city = user.City;
            zipCode = user.ZipCode;
            country = user.Country;
        }

        InvokeAsync(StateHasChanged);
    }

    private async Task SaveUser()
    {
        // The address is optional, like everywhere else
        if (string.IsNullOrWhiteSpace(firstName) || string.IsNullOrWhiteSpace(lastName) || birthday is null)
        {
            Snackbar.Add(L["FillRequiredFields"], Severity.Warning);
            return;
        }

        var success = await AdminStore.UpdateUser(UserId, new UpdateAdminUserRequest
        {
            FirstName = firstName,
            LastName = lastName,
            Birthday = DateOnly.FromDateTime(birthday.Value),
            Gender = gender,
            Street = street,
            City = city,
            ZipCode = zipCode,
            Country = country
        });

        if (success)
        {
            Snackbar.Add(L["UserUpdated"], Severity.Success);
            await AdminStore.LoadUser(UserId);
        }
        else
        {
            Snackbar.Add(L["FailedUpdateUser"], Severity.Error);
        }
    }

    private async Task ResendConfirmation()
    {
        var success = await AdminStore.ResendConfirmationEmail(UserId);
        Snackbar.Add(success ? L["ConfirmationEmailSent"] : L["FailedSendConfirmation"],
            success ? Severity.Success : Severity.Error);
    }

    private async Task ChangeEmail()
    {
        if (string.IsNullOrWhiteSpace(newEmail))
        {
            Snackbar.Add(L["EnterNewEmail"], Severity.Warning);
            return;
        }

        var success = await AdminStore.ChangeEmail(UserId, new ChangeUserEmailRequest { NewEmail = newEmail });
        if (success)
        {
            Snackbar.Add(L["EmailChangeConfirmationSent"], Severity.Success);
            newEmail = "";
        }
        else
        {
            Snackbar.Add(L["FailedChangeEmail"], Severity.Error);
        }
    }

    private async Task ResetPassword()
    {
        var success = await AdminStore.ResetPassword(UserId);
        Snackbar.Add(success ? L["PasswordResetLinkSent"] : L["FailedSendPasswordReset"],
            success ? Severity.Success : Severity.Error);
    }

    private async Task DeleteUser()
    {
        var result = await DialogService.ShowMessageBox(
            L["ConfirmDeletion"],
            L["DeleteUserConfirm"],
            yesText: SharedLocale["Delete"], cancelText: SharedLocale["Cancel"]);

        if (result != true)
            return;

        if (await AdminStore.DeleteUser(UserId))
        {
            Snackbar.Add(L["UserDeleted"], Severity.Success);
            NavigationManager.NavigateTo("/admin/users");
        }
        else
        {
            Snackbar.Add(L["FailedDeleteUser"], Severity.Error);
        }
    }

    private async Task ImpersonateUser()
    {
        var result = await DialogService.ShowMessageBox(
            L["Impersonate"],
            L["ImpersonateConfirm"],
            yesText: L["Confirm"], cancelText: SharedLocale["Cancel"]);

        if (result != true)
            return;

        if (await AdminStore.ImpersonateUser(UserId))
        {
            Snackbar.Add(L["ImpersonationSuccess"], Severity.Success);
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
        else
        {
            Snackbar.Add(L["FailedImpersonate"], Severity.Error);
        }
    }

    public void Dispose() => AdminStore.OnUserDetailChanged -= OnUserDetailChanged;
}
