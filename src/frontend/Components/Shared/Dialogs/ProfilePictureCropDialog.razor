@implements IAsyncDisposable

<MudDialog>
    <DialogContent>
        <div style="max-height: 60vh; overflow: hidden;">
            <img id="cropperImage" src="@ImageDataUrl" alt="" style="max-width: 100%; display: block;" />
        </div>
        <MudText Typo="Typo.caption" Class="mt-2" Style="color: var(--mud-palette-text-secondary);">
            Drag to move · Resize the box to crop · Pinch or scroll to zoom
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined" Color="Color.Secondary">Cancel</MudButton>
        <MudButton OnClick="Confirm" Variant="Variant.Filled" Color="Color.Primary">Use Photo</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] private IJSRuntime JS { get; set; } = null!;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired] public string ImageDataUrl { get; set; } = null!;

    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Import the self-contained ES module. Using a stable URL so the browser
            // reuses the same module instance across multiple dialog opens on the
            // same page. The no-cache response header on this file ensures the browser
            // always revalidates and picks up the latest version after a deploy.
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "/cropper-interop.js");
            await _module.InvokeVoidAsync("initCropper", "cropperImage");
        }
    }

    private async Task Confirm()
    {
        if (_module is null) return;
        var croppedDataUrl = await _module.InvokeAsync<string>("getCroppedDataUrl", 256, 256, 0.85);
        await _module.InvokeVoidAsync("destroyCropper");
        MudDialog.Close(DialogResult.Ok(croppedDataUrl));
    }

    private async Task Cancel()
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("destroyCropper");
        MudDialog.Cancel();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("destroyCropper");
                await _module.DisposeAsync();
            }
            catch { /* ignore if JS runtime is gone during navigation */ }
        }
    }
}

