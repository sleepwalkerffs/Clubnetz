@using MudBlazor

<div style="position: relative; display: inline-block;" class="@Class">
    @if (ProfilePictureUrl is not null)
    {
        <MudAvatar Size="@Size" Class="@AvatarClass">
            <img src="@ProfilePictureUrl" alt="" style="width: 100%; height: 100%; object-fit: cover;" />
        </MudAvatar>
    }
    else
    {
        <MudAvatar Color="@Color" Size="@Size" Class="@AvatarClass">@Initials</MudAvatar>
    }

    @if (BadgeImageUrl is not null)
    {
        <div style="@GetBadgeContainerStyle()">
            <BadgeIcon ImageUrl="@BadgeImageUrl" Level="BadgeLevel" Size="Size.Small" />
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string FirstName { get; set; } = null!;
    [Parameter, EditorRequired] public string LastName { get; set; } = null!;
    [Parameter] public string? ProfilePictureUrl { get; set; }
    [Parameter] public string? BadgeImageUrl { get; set; }
    [Parameter] public int? BadgeLevel { get; set; }
    [Parameter] public Size Size { get; set; } = Size.Medium;
    [Parameter] public Color Color { get; set; } = Color.Default;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? AvatarClass { get; set; }

    private string Initials =>
        $"{(FirstName.Length > 0 ? FirstName[0] : ' ')}{(LastName.Length > 0 ? LastName[0] : ' ')}";

    private string GetBadgeContainerStyle() => Size switch
    {
        Size.Small => "position: absolute; top: -4px; right: -4px; transform: scale(0.6); transform-origin: top right;",
        Size.Medium => "position: absolute; top: -4px; right: -4px; transform: scale(0.75); transform-origin: top right;",
        _ => "position: absolute; top: -4px; right: -4px;"
    };
}
