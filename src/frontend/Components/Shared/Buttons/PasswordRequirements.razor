@using Bookennis.Client.Localization.Pages.Account
@using Bookennis.Client.Pages.Account

@* Live checklist of the password rules, updated while the user types. *@
<ul class="password-requirements" aria-live="polite">
    @foreach (var rule in PasswordValidation.Rules)
    {
        var ok = !string.IsNullOrEmpty(Password) && rule.IsSatisfied(Password);
        <li class="@($"password-requirement {(ok ? "password-requirement--ok" : "")}")">
            <MudIcon Icon="@(ok ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.Circle)" Size="Size.Small" Class="password-requirement__icon" />
            <span>@Locale[rule.LocaleKey]</span>
        </li>
    }
</ul>

@code {
    [Inject] private IStringLocalizer<AccountLocale> Locale { get; set; } = null!;

    [Parameter] public string? Password { get; set; }
}
