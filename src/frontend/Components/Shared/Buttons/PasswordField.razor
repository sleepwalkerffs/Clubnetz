@using System.Linq.Expressions
@typeparam TType

<MudTextField Variant=@Variant
              T="TType"
              Label=@Label
              HelperText=@HelperText
              Value="@Value"
              ValueChanged="ValueHasChanged"
              Immediate="@Immediate"
              UserAttributes="@userAttributes"
              For="@For"
              InputType="@PasswordInput"
              Adornment="Adornment.End"
              AdornmentIcon="@PasswordInputIcon"
              OnAdornmentClick="TogglePasswordVisibility"
              AdornmentAriaLabel="Show Password"
              Underline=@(!DisableUnderline)/>

@code {
    [Parameter]
    public string HelperText { get; set; } = null!;

    [Parameter]
    public string Label { get; set; } = null!;

    [Parameter]
    public TType? Value { get; set; }

    [Parameter]
    public EventCallback<TType> ValueChanged { get; set; }

    [Parameter]
    public Expression<Func<TType>>? For { get; set; } = null;

    [Parameter]
    public bool DisableUnderline { get; set; } = false;

    [Parameter]
    public Variant Variant { get; set; } = Variant.Outlined;

    /// <summary>Updates the value on every key stroke instead of on blur, e.g. for the live password requirement checklist.</summary>
    [Parameter]
    public bool Immediate { get; set; }

    /// <summary>The autocomplete hint for password managers, e.g. "current-password" or "new-password".</summary>
    [Parameter]
    public string? AutoComplete { get; set; }

    private Dictionary<string, object?> userAttributes => AutoComplete is null ? [] : new() { ["autocomplete"] = AutoComplete };

    private void ValueHasChanged(TType value)
    {
        Value = value;
        ValueChanged.InvokeAsync(Value);
    }

    bool showPassword;
    InputType PasswordInput = InputType.Password;
    string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    void TogglePasswordVisibility()
    {
        if (showPassword)
        {
            showPassword = false;
            PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            PasswordInput = InputType.Password;
        }
        else
        {
            showPassword = true;
            PasswordInputIcon = Icons.Material.Filled.Visibility;
            PasswordInput = InputType.Text;
        }
    }
}
