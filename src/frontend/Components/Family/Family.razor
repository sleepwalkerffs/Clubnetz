@using Bookennis.Client.Components.Family.Dialogs
@using Bookennis.Client.Components.Shared
@using Bookennis.Client.Localization
@using Bookennis.Client.Localization.Components.Family
@using Bookennis.Client.Services.Store.Family
@using Bookennis.Shared.Controller.Families

@implements IDisposable

@if (Embedded)
{
    @Body
}
else
{
    <SectionCard Emoji="👨‍👩‍👧" Title="@FamilySharedLocale["Family"]" Subtitle="@FamilySharedLocale[ManagedByClub ? "FamilySubtitleManaged" : "FamilySubtitle"]">
        @Body
    </SectionCard>
}

@code {
    private RenderFragment Body => __builder =>
    {
        <div class="family-group">
            <div class="family-group__label">@FamilySharedLocale[IsChild ? "Parents" : "Partner"]</div>
            @foreach (var parent in Partners)
            {
                <div class="family-member">
                    <UserAvatar FirstName="@parent.FirstName" LastName="@parent.LastName" Color="Color.Secondary" />
                    <div class="family-member__text">
                        <div class="family-member__name">@parent.FirstName @parent.LastName</div>
                    </div>
                    @if (CanManage)
                    {
                        <MudTooltip Text="@FamilySharedLocale["RemoveFamilyMember"]">
                            <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Outlined.Delete"
                                           aria-label="@FamilySharedLocale["RemoveFamilyMember"]"
                                           OnClick="_ => OpenDeleteDialog(parent)" />
                        </MudTooltip>
                    }
                </div>
            }
            @if (CanManage && (FamilyStore.Family?.Parents.Count ?? 1) < 2)
            {
                <button type="button" class="family-add" @onclick="AddPartner">
                    <MudIcon Icon="@Icons.Material.Filled.FavoriteBorder" Size="Size.Small" />
                    @FamilySharedLocale["SelectPartner"]
                </button>
            }
            else if (Partners.Count == 0)
            {
                <div class="family-group__empty">–</div>
            }
        </div>

        <div class="family-group">
            <div class="family-group__label">@FamilySharedLocale[IsChild ? "Siblings" : "Children"]</div>
            @foreach (var child in Children)
            {
                <div class="family-member">
                    <UserAvatar FirstName="@child.FirstName" LastName="@child.LastName" Color="Color.Tertiary" />
                    <div class="family-member__text">
                        <div class="family-member__name">@child.FirstName @child.LastName</div>
                        <div class="family-member__meta">@string.Format(FamilySharedLocale["ChildAge"], GetAge(child.Birthday))</div>
                    </div>
                    @if (CanManage)
                    {
                        <div class="d-flex">
                            @if (child.IsOwnedAccount)
                            {
                                <MudTooltip Text="@FamilySharedLocale["EditChild"]">
                                    <MudIconButton Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Outlined.Edit"
                                                   aria-label="@FamilySharedLocale["EditChild"]"
                                                   OnClick="_ => OpenEditChildDialog(child)" />
                                </MudTooltip>
                            }
                            <MudTooltip Text="@FamilySharedLocale["RemoveFamilyMember"]">
                                <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Outlined.Delete"
                                               aria-label="@FamilySharedLocale["RemoveFamilyMember"]"
                                               OnClick="_ => OpenDeleteDialog(child)" />
                            </MudTooltip>
                        </div>
                    }
                </div>
            }
            @if (CanManage)
            {
                <button type="button" class="family-add" @onclick="AddChildren">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                    @FamilySharedLocale["AddChild"]
                </button>
            }
            else if (Children.Count == 0)
            {
                <div class="family-group__empty">–</div>
            }
        </div>
    };

    /// <summary>The member whose family is shown: the partner, the children, or for a child the parents and siblings.</summary>
    [Parameter]
    public required int MemberId { get; set; }
    [Parameter]
    public required int? FamilyId { get; set; }

    /// <summary>The last name a new child starts with.</summary>
    [Parameter]
    public string? LastName { get; set; }

    /// <summary>An admin or a treasurer puts the family of a member together; the API lets them change every family of the club.</summary>
    [Parameter]
    public bool ManagedByClub { get; set; }

    /// <summary>Without the card around it, e.g. inside a dialog.</summary>
    [Parameter]
    public bool Embedded { get; set; }

    /// <summary>The family was founded or changed; the value is its id (<c>null</c> when it no longer exists).</summary>
    [Parameter]
    public EventCallback<int?> OnChanged { get; set; }

    [Inject]
    private IFamilyStore FamilyStore { get; set; } = null!;
    [Inject]
    private IDialogService DialogService { get; set; } = null!;
    [Inject]
    private IStringLocalizer<FamilySharedLocale> FamilySharedLocale { get; set; } = null!;
    [Inject]
    private IStringLocalizer<SharedLocale> SharedLocale { get; set; } = null!;

    private static readonly DialogOptions DialogOptions = new() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true };

    private (int MemberId, int? FamilyId)? shown;

    /// <summary>Only the parents change a family (the API refuses everybody else); without a family the member can found one.</summary>
    private bool CanManage => ManagedByClub || FamilyStore.Family is null || FamilyStore.Family.Parents.Any(p => p.MemberId == MemberId);

    private bool IsChild => FamilyStore.Family?.Children.Any(c => c.MemberId == MemberId) == true;

    private List<FamilyParentDto> Partners => FamilyStore.Family?.Parents.Where(p => p.MemberId != MemberId).ToList() ?? [];

    private List<FamilyChildDto> Children => FamilyStore.Family?.Children.Where(c => c.MemberId != MemberId).ToList() ?? [];

    private static int GetAge(DateOnly birthday)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var age = today.Year - birthday.Year;
        return birthday > today.AddYears(-age) ? age - 1 : age;
    }

    protected override void OnInitialized() => FamilyStore.OnFamilyChanged += StateHasChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (shown == (MemberId, FamilyId))
            return;

        shown = (MemberId, FamilyId);
        if (FamilyId is not { } familyId)
            FamilyStore.ResetFamily();
        else if (!FamilyStore.LoadedForFamilyId(familyId))
            await FamilyStore.LoadFamily(familyId);
    }

    private async Task AddPartner()
    {
        var parameters = new DialogParameters<SelectPartner> { { dialog => dialog.MemberId, MemberId } };
        var dialog = await DialogService.ShowAsync<SelectPartner>(FamilySharedLocale["SelectPartner"], parameters, DialogOptions);
        await NotifyUnlessCanceled(dialog);
    }

    private async Task AddChildren()
    {
        var parameters = new DialogParameters<AddNewChild>
        {
            { dialog => dialog.MemberId, MemberId },
            { dialog => dialog.LastName, LastName },
        };
        var dialog = await DialogService.ShowAsync<AddNewChild>(FamilySharedLocale["AddChild"], parameters, DialogOptions);
        await NotifyUnlessCanceled(dialog);
    }

    private async Task OpenEditChildDialog(FamilyChildDto child)
    {
        var parameters = new DialogParameters<EditChildDialog> { { dialog => dialog.Child, child } };
        var dialog = await DialogService.ShowAsync<EditChildDialog>(FamilySharedLocale["EditChild"], parameters, DialogOptions);
        await NotifyUnlessCanceled(dialog);
    }

    private async Task OpenDeleteDialog(FamilyMemberDto familyMember)
    {
        var approved = await DialogService.ShowMessageBox(
            title: FamilySharedLocale["RemoveFamilyMember"],
            message: string.Format(FamilySharedLocale[ManagedByClub ? "RemoveFamilyMemberConfirmationManaged" : "RemoveFamilyMemberConfirmation"], $"{familyMember.FirstName} {familyMember.LastName}"),
            yesText: SharedLocale["Delete"],
            cancelText: SharedLocale["Cancel"]);

        if (approved is not null && approved.Value)
        {
            await FamilyStore.RemoveFamilyMember(familyMember.MemberId);
            await Notify();
        }
    }

    private async Task NotifyUnlessCanceled(IDialogReference dialog)
    {
        if (await dialog.Result is { Canceled: false })
            await Notify();
    }

    private Task Notify() => OnChanged.InvokeAsync(FamilyStore.Family?.FamilyId);

    public void Dispose()
    {
        FamilyStore.OnFamilyChanged -= StateHasChanged;
        FamilyStore.ResetFamily();
    }
}
