@using Bookennis.Client.Components.Shared
@using Bookennis.Client.Components.Family
@using Bookennis.Client.Components.Shared.Dialogs
@using Bookennis.Client.Localization
@using Bookennis.Client.Localization.Components.Family
@using Bookennis.Client.Localization.Pages.Account
@using Bookennis.Client.Services.Store.Family
@using Bookennis.Shared.Controller.Families
@using System.ComponentModel.DataAnnotations
@using Bookennis.Shared.Controller.Shared

<BaseDialog SubmitFunc="Submit" SubmitCaption="@SharedLocale["Add"]" CancelFunc="Cancel" CancelCaption="@SharedLocale["Cancel"]" CanSubmit="@(!existing || selected.Count > 0)"
            Loading="@FamilyStore.IsSaving" Title="@FamilySharedLocale["AddChild"]" AllowFullScreen="false">
    <div class="family-dialog">
        @if (loaded && FamilyStore.AvailableFamilyMembers.Count > 0)
        {
            <ChoiceChips TItem="bool" Items="@Modes" @bind-Value="existing" TextFunc="@(isMember => FamilySharedLocale[isMember ? "ChildIsMember" : "ChildIsNew"])"
                         Label="@FamilySharedLocale["ChildMode"]" />
        }

        @if (existing)
        {
            <p class="family-dialog__hint">@FamilySharedLocale["ChildIsMemberHint"]</p>
            <MemberPickList Items="@FamilyStore.AvailableFamilyMembers" @bind-Values="selected" Multi="true" Label="@FamilySharedLocale["ChildIsMember"]" />
        }
        else
        {
            <p class="family-dialog__hint">@FamilySharedLocale["ChildIsNewHint"]</p>
            <MudForm @ref="mudForm" Model="formModel">
                <div class="family-dialog__form">
                    <MudTextField Variant="Variant.Outlined" T="string" Label="@SharedLocale["Firstname"]" @bind-Value="formModel.FirstName" For="@(() => formModel.FirstName)" Required="true" MaxLength="100" />
                    <MudTextField Variant="Variant.Outlined" T="string" Label="@SharedLocale["Lastname"]" @bind-Value="formModel.LastName" For="@(() => formModel.LastName)" Required="true" MaxLength="100" />
                    <MudDatePicker Variant="Variant.Outlined" Label="@SharedLocale["Birthday"]" @bind-Date="formModel.Birthday" For="@(() => formModel.Birthday)" DateFormat="dd.MM.yyyy"
                                   Required="true" MaxDate="@DateTime.Today" OpenTo="OpenTo.Year" PickerVariant="PickerVariant.Dialog" />
                    <ChoiceChips TItem="Gender" Items="@Genders" @bind-Value="formModel.Gender" TextFunc="@(gender => FamilySharedLocale[$"Gender_{gender}"])" Label="@SharedLocale["Gender"]" />
                </div>
            </MudForm>
        }
    </div>
</BaseDialog>

@code {
    private static readonly bool[] Modes = [false, true];
    private static readonly Gender[] Genders = [Gender.Female, Gender.Male, Gender.Diverse];

    /// <summary>The member whose child is added. Without a family yet, the member becomes its parent.</summary>
    [Parameter]
    public int MemberId { get; set; }

    /// <summary>The last name the form starts with: the one of the parent.</summary>
    [Parameter]
    public string? LastName { get; set; }

    [Inject]
    private IFamilyStore FamilyStore { get; set; } = null!;
    [Inject]
    private IStringLocalizer<SharedLocale> SharedLocale { get; set; } = null!;
    [Inject]
    private IStringLocalizer<FamilySharedLocale> FamilySharedLocale { get; set; } = null!;

    private bool existing;
    private bool loaded;
    private MemberModel formModel = new();
    private MudForm mudForm = null!;
    private IReadOnlyCollection<int> selected = [];

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        formModel.LastName = LastName ?? "";
        await FamilyStore.LoadAvailableFamilyMembers(MemberId);
        loaded = true;
    }

    private async Task<DialogResult?> Submit()
    {
        if (existing)
        {
            if (selected.Count == 0)
                return null;

            if (FamilyStore.Family is null)
                await FamilyStore.CreateFamily(new CreateFamilyRequest { ParentContractUserIds = [MemberId], ChildrenUserContractIds = selected.ToList() });
            else
                await FamilyStore.AddChildren(selected.ToList());
        }
        else
        {
            await mudForm.Validate();
            if (!mudForm.IsValid)
                return null;

            var child = new AddNewChildRequest(formModel.FirstName, formModel.LastName, DateOnly.FromDateTime(formModel.Birthday!.Value), formModel.Gender);
            if (FamilyStore.Family is null)
                await FamilyStore.CreateFamily(new CreateFamilyRequest { ParentContractUserIds = [MemberId], NewChildUsers = [child] });
            else
                await FamilyStore.AddNewChild(child);
        }

        return DialogResult.Ok((object?)null);
    }

    private Task<DialogResult> Cancel() => Task.FromResult(DialogResult.Cancel());

    public class MemberModel
    {
        public Gender Gender { get; set; } = Gender.Female;

        [Required(ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "FirstnameValidation")]
        public string FirstName { get; set; } = "";

        [Required(ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "LastnameValidation")]
        public string LastName { get; set; } = "";

        [Required(ErrorMessageResourceType = typeof(AccountLocale), ErrorMessageResourceName = "BirthdayValidation")]
        public DateTime? Birthday { get; set; }
    }
}
