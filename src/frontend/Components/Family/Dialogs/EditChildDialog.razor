@using Bookennis.Client.Components.Shared
@using Bookennis.Client.Components.Shared.Dialogs
@using Bookennis.Client.Localization
@using Bookennis.Client.Localization.Components.Family
@using Bookennis.Client.Services.Store.Family
@using Bookennis.Shared.Controller.Families
@using Bookennis.Shared.Controller.Shared

<BaseDialog SubmitFunc="Submit" SubmitCaption="@SharedLocale["Save"]" CancelFunc="Cancel" CancelCaption="@SharedLocale["Cancel"]"
            Loading="@FamilyStore.IsSaving" Title="@FamilySharedLocale["EditChild"]" AllowFullScreen="false">
    <MudForm @ref="mudForm">
        <div class="family-dialog__form">
            <MudTextField Variant="Variant.Outlined" T="string" Label="@SharedLocale["Firstname"]" @bind-Value="firstName" Required="true" MaxLength="100" />
            <MudTextField Variant="Variant.Outlined" T="string" Label="@SharedLocale["Lastname"]" @bind-Value="lastName" Required="true" MaxLength="100" />
            <MudDatePicker Variant="Variant.Outlined" Label="@SharedLocale["Birthday"]" @bind-Date="birthday" DateFormat="dd.MM.yyyy" Required="true"
                           MaxDate="@DateTime.Today" PickerVariant="PickerVariant.Dialog" />
            <ChoiceChips TItem="Gender" Items="@Genders" @bind-Value="gender" TextFunc="@(value => FamilySharedLocale[$"Gender_{value}"])" Label="@SharedLocale["Gender"]" />
        </div>
    </MudForm>
</BaseDialog>

@code {
    private static readonly Gender[] Genders = [Gender.Female, Gender.Male, Gender.Diverse];

    [Parameter]
    public required FamilyChildDto Child { get; set; }

    [Inject]
    private IFamilyStore FamilyStore { get; set; } = null!;
    [Inject]
    private IStringLocalizer<SharedLocale> SharedLocale { get; set; } = null!;
    [Inject]
    private IStringLocalizer<FamilySharedLocale> FamilySharedLocale { get; set; } = null!;

    private MudForm mudForm = null!;
    private string firstName = string.Empty;
    private string lastName = string.Empty;
    private DateTime? birthday;
    private Gender gender;

    protected override void OnInitialized()
    {
        firstName = Child.FirstName;
        lastName = Child.LastName;
        birthday = Child.Birthday.ToDateTime(TimeOnly.MinValue);
        gender = Child.Gender;
    }

    private async Task<DialogResult?> Submit()
    {
        await mudForm.Validate();
        if (!mudForm.IsValid)
            return null;

        await FamilyStore.UpdateOwnedChild(
            Child.MemberId,
            new UpdateOwnedChildRequest(firstName, lastName, DateOnly.FromDateTime(birthday!.Value), gender));

        return DialogResult.Ok(Child);
    }

    private Task<DialogResult> Cancel() => Task.FromResult(DialogResult.Cancel());
}
