@using Bookennis.Client.Components.Family
@using Bookennis.Client.Components.Shared.Dialogs
@using Bookennis.Client.Localization
@using Bookennis.Client.Localization.Components.Family
@using Bookennis.Client.Services.Store.Family
@using Bookennis.Shared.Controller.Families

<BaseDialog SubmitFunc="Submit" SubmitCaption="@SharedLocale["Add"]" CancelFunc="Cancel" CancelCaption="@SharedLocale["Cancel"]" CanSubmit="@(selected.Count == 1)"
            Loading="@FamilyStore.IsSaving" Title="@FamilySharedLocale["SelectPartner"]" AllowFullScreen="false">
    <div class="family-dialog">
        <p class="family-dialog__hint">@FamilySharedLocale["SelectPartnerHint"]</p>

        @if (loaded)
        {
            <MemberPickList Items="@FamilyStore.AvailableFamilyMembers" @bind-Values="selected" Label="@FamilySharedLocale["SelectPartner"]" />
        }
    </div>
</BaseDialog>

@code {
    /// <summary>The member whose partner is chosen.</summary>
    [Parameter]
    public int MemberId { get; set; }

    [Inject]
    private IFamilyStore FamilyStore { get; set; } = null!;

    [Inject]
    private IStringLocalizer<SharedLocale> SharedLocale { get; set; } = null!;
    [Inject]
    private IStringLocalizer<FamilySharedLocale> FamilySharedLocale { get; set; } = null!;

    private IReadOnlyCollection<int> selected = [];
    private bool loaded;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await FamilyStore.LoadAvailableFamilyMembers(MemberId);
        loaded = true;
    }

    private async Task<DialogResult?> Submit()
    {
        if (selected.Count != 1)
            return null;

        var partnerId = selected.Single();
        if (FamilyStore.Family is null)
            await FamilyStore.CreateFamily(new CreateFamilyRequest { ParentContractUserIds = [MemberId, partnerId] });
        else
            await FamilyStore.AddParent(partnerId);

        return DialogResult.Ok((object?)null);
    }

    private Task<DialogResult> Cancel() => Task.FromResult(DialogResult.Cancel());
}
